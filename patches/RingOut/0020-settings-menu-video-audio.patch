diff --git a/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.cpp b/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.cpp
new file mode 100644
index 00000000..20b478f4
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.cpp
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "AudioCommon/TrebleShelf.h"
+
+#include <cmath>
+#include <numbers>
+
+#include "Common/MathUtil.h"
+
+namespace AudioCommon
+{
+namespace
+{
+// Where the shelf is half-way up. Low enough to reach the presence range that
+// reads as "muffled" when missing, high enough to leave voices' body alone.
+constexpr float kCornerHz = 5000.0f;
+}  // namespace
+
+void TrebleShelf::Configure(int gain_db, u32 sample_rate)
+{
+  m_gain_db = gain_db;
+  m_sample_rate = sample_rate;
+  m_channels = {};
+
+  // High shelf, slope S = 1 (the steepest without overshoot).
+  const float a = std::pow(10.0f, static_cast<float>(gain_db) / 40.0f);
+  const float w0 = 2.0f * std::numbers::pi_v<float> * kCornerHz / static_cast<float>(sample_rate);
+  const float cos_w0 = std::cos(w0);
+  const float alpha = std::sin(w0) / 2.0f * std::sqrt(2.0f);
+  const float two_sqrt_a_alpha = 2.0f * std::sqrt(a) * alpha;
+
+  const float a0 = (a + 1.0f) - (a - 1.0f) * cos_w0 + two_sqrt_a_alpha;
+  m_coefficients.b0 = a * ((a + 1.0f) + (a - 1.0f) * cos_w0 + two_sqrt_a_alpha) / a0;
+  m_coefficients.b1 = -2.0f * a * ((a - 1.0f) + (a + 1.0f) * cos_w0) / a0;
+  m_coefficients.b2 = a * ((a + 1.0f) + (a - 1.0f) * cos_w0 - two_sqrt_a_alpha) / a0;
+  m_coefficients.a1 = 2.0f * ((a - 1.0f) - (a + 1.0f) * cos_w0) / a0;
+  m_coefficients.a2 = ((a + 1.0f) - (a - 1.0f) * cos_w0 - two_sqrt_a_alpha) / a0;
+}
+
+void TrebleShelf::Process(s16* samples, std::size_t num_frames, u32 sample_rate)
+{
+  const int gain_db = m_requested_gain_db.load(std::memory_order_relaxed);
+  if (gain_db == 0 || sample_rate == 0)
+  {
+    m_gain_db = 0;
+    return;
+  }
+  if (gain_db != m_gain_db || sample_rate != m_sample_rate)
+    Configure(gain_db, sample_rate);
+
+  const Coefficients& c = m_coefficients;
+  for (std::size_t i = 0; i < num_frames * 2; ++i)
+  {
+    ChannelState& ch = m_channels[i & 1];
+    const float x0 = samples[i];
+    const float y0 = c.b0 * x0 + c.b1 * ch.x1 + c.b2 * ch.x2 - c.a1 * ch.y1 - c.a2 * ch.y2;
+    ch.x2 = ch.x1;
+    ch.x1 = x0;
+    ch.y2 = ch.y1;
+    ch.y1 = y0;
+    samples[i] = MathUtil::SaturatingCast<s16>(std::lround(y0));
+  }
+}
+}  // namespace AudioCommon
diff --git a/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.h b/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.h
new file mode 100644
index 00000000..5ef9c0d8
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/AudioCommon/TrebleShelf.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Optional treble boost on the mixer's output: a high-shelf biquad (RBJ Audio EQ
+// Cookbook) per channel. The GameCube DSP runs at 32 kHz, so nothing above 16 kHz
+// ever existed and many games sound dull next to modern audio; lifting the top
+// octaves is a matter of taste, not accuracy, so it is off by default.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+
+#include "Common/CommonTypes.h"
+
+namespace AudioCommon
+{
+class TrebleShelf
+{
+public:
+  // Safe from any thread; picked up by the next Process call.
+  void SetGainDb(int gain_db) { m_requested_gain_db.store(gain_db, std::memory_order_relaxed); }
+
+  // Filters interleaved stereo s16 in place. Called on the audio thread only.
+  void Process(s16* samples, std::size_t num_frames, u32 sample_rate);
+
+private:
+  struct Coefficients
+  {
+    float b0 = 1.0f, b1 = 0.0f, b2 = 0.0f, a1 = 0.0f, a2 = 0.0f;
+  };
+  struct ChannelState
+  {
+    float x1 = 0.0f, x2 = 0.0f, y1 = 0.0f, y2 = 0.0f;
+  };
+
+  void Configure(int gain_db, u32 sample_rate);
+
+  std::atomic<int> m_requested_gain_db{0};
+  // Audio-thread state.
+  int m_gain_db = 0;
+  u32 m_sample_rate = 0;
+  Coefficients m_coefficients;
+  std::array<ChannelState, 2> m_channels{};
+};
+}  // namespace AudioCommon
