diff --git a/ModernGekko/vendor/dolphin/Source/Core/DolphinNoGUI/PlatformWin32.cpp b/ModernGekko/vendor/dolphin/Source/Core/DolphinNoGUI/PlatformWin32.cpp
index 13d9e351..367799ca 100644
--- a/ModernGekko/vendor/dolphin/Source/Core/DolphinNoGUI/PlatformWin32.cpp
