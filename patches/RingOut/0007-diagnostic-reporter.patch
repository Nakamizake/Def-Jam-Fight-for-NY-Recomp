+using Clock = std::chrono::steady_clock;
+
+std::int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             Clock::now().time_since_epoch())
+      .count();
+}
+
+std::string LocalTimestamp(const char *format) {
+  const std::time_t now = std::time(nullptr);
+  std::tm local{};
+#if defined(_WIN32)
+  localtime_s(&local, &now);
+#else
+  localtime_r(&now, &local);
+#endif
+  char text[32];
+  std::strftime(text, sizeof(text), format, &local);
+  return text;
+}
+
+const char *CoreStateName(Core::State state) {
+  switch (state) {
+  case Core::State::Uninitialized: return "uninitialized";
+  case Core::State::Paused: return "paused";
+  case Core::State::Running: return "running";
+  case Core::State::Stopping: return "stopping";
+  case Core::State::Starting: return "starting";
+  }
+  return "unknown";
+}
+
+// --- guest -------------------------------------------------------------------
+
+// Reads a big-endian guest word from RAM, or nothing if the address is not RAM.
+std::optional<u32> ReadGuestWord(const CPUState &cpu, u32 address) {
+  if (address < 0x80000000u || !cpu.ram)
+    return std::nullopt;
+  const u32 offset = address & 0x3FFFFFFFu;  // 0x8 cached and 0xC uncached mirrors
+  if ((address & 3) != 0 || offset + 4 > cpu.ram_size)
+    return std::nullopt;
+  u32 value;
+  std::memcpy(&value, cpu.ram + offset, sizeof(value));
+  return Common::swap32(value);
+}
+
+// PowerPC EABI: each frame starts with the caller's stack pointer (the back
+// chain), and a non-leaf function saves its return address one word above its
+// caller's frame. The innermost entry may be stale while the current function
+// is a leaf or has not saved lr yet.
+void DescribeGuestCallStack(const CPUState &cpu, u32 stack_pointer, int max_depth,
+                            const char *indent, std::string &out) {
+  u32 frame = stack_pointer;
+  for (int depth = 0; depth < max_depth; ++depth) {
+    const std::optional<u32> caller_frame = ReadGuestWord(cpu, frame);
+    if (!caller_frame || *caller_frame <= frame)
+      break;
+    const std::optional<u32> return_address = ReadGuestWord(cpu, *caller_frame + 4);
+    if (!return_address)
+      break;
+    fmt::format_to(std::back_inserter(out), "{}#{:02} {:08x}  (frame {:08x})\n", indent, depth,
+                   *return_address, *caller_frame);
+    frame = *caller_frame;
+  }
+}
+
+void DescribeGuest(std::string &out) {
+  if (!g_static_recomp_core) {
+    out += "  static recompiler core not active\n";
+    return;
+  }
+  const CPUState &cpu = g_static_recomp_core->GuestStateForDiagnostics();
+  fmt::format_to(std::back_inserter(out),
+                 "  pc {:08x}  lr {:08x}  ctr {:08x}  msr {:08x}  cr {:08x}  xer {:08x}\n",
+                 cpu.pc, cpu.lr, cpu.ctr, cpu.msr, cpu_cr_get(&cpu), cpu.xer);
+  for (int i = 0; i < 32; i += 4) {
+    fmt::format_to(std::back_inserter(out), "  r{:<2} {:08x}  r{:<2} {:08x}  r{:<2} {:08x}  r{:<2} {:08x}\n",
+                   i, cpu.gpr[i], i + 1, cpu.gpr[i + 1], i + 2, cpu.gpr[i + 2], i + 3,
+                   cpu.gpr[i + 3]);
+  }
+  out += "  call stack (saved return addresses, innermost first):\n";
+  DescribeGuestCallStack(cpu, cpu.gpr[1], 48, "    ", out);
+}
+
+// The Dolphin OS thread list (Core/Debugger/OSThread.h has the layout): every
+// game thread with its state, what it is blocked on and where it stopped. In a
+// freeze this is usually the whole answer -- who waits on which queue.
+void DescribeGuestThreads(std::string &out) {
+  if (!g_static_recomp_core) {
+    out += "  static recompiler core not active\n";
+    return;
+  }
+  const CPUState &cpu = g_static_recomp_core->GuestStateForDiagnostics();
+  constexpr u32 kActiveQueueHead = 0x800000DC;
+  constexpr u32 kCurrentThread = 0x800000E4;
+  constexpr u32 kState = 0x2C8, kSuspend = 0x2CC, kPriority = 0x2D0, kQueue = 0x2DC,
+                kMutex = 0x2F0, kNextActive = 0x2FC, kLr = 0x84, kSrr0 = 0x198, kGpr1 = 0x4;
+  const auto read16 = [&](u32 address) -> std::optional<u32> {
+    const std::optional<u32> word = ReadGuestWord(cpu, address & ~3u);
+    if (!word)
+      return std::nullopt;
+    return (address & 2) ? (*word & 0xFFFF) : (*word >> 16);
+  };
+  const std::optional<u32> current = ReadGuestWord(cpu, kCurrentThread);
+  std::optional<u32> thread = ReadGuestWord(cpu, kActiveQueueHead);
+  for (int count = 0; thread && *thread != 0 && count < 64; ++count) {
+    const u32 t = *thread;
+    const std::optional<u32> state = read16(t + kState);
+    if (!state)
+      break;
+    const char *state_name = *state == 1 ? "ready" : *state == 2 ? "running" :
+                             *state == 4 ? "waiting" : *state == 8 ? "moribund" : "?";
+    fmt::format_to(std::back_inserter(out),
+                   "  thread {:08x}{}  {}  priority {}  suspend {}  waits on queue {:08x}  "
+                   "mutex {:08x}\n    saved pc {:08x}  lr {:08x}  sp {:08x}\n",
+                   t, current && *current == t ? " (current)" : "", state_name,
+                   ReadGuestWord(cpu, t + kPriority).value_or(0),
+                   static_cast<s32>(ReadGuestWord(cpu, t + kSuspend).value_or(0)),
+                   ReadGuestWord(cpu, t + kQueue).value_or(0),
+                   ReadGuestWord(cpu, t + kMutex).value_or(0),
+                   ReadGuestWord(cpu, t + kSrr0).value_or(0), ReadGuestWord(cpu, t + kLr).value_or(0),
+                   ReadGuestWord(cpu, t + kGpr1).value_or(0));
+    DescribeGuestCallStack(cpu, ReadGuestWord(cpu, t + kGpr1).value_or(0), 12, "      ", out);
+    thread = ReadGuestWord(cpu, t + kNextActive);
+  }
+}
