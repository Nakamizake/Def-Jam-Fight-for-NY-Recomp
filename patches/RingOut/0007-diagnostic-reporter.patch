@@ -0,0 +1,66 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include "Common/HookableEvent.h"
+
+namespace moderngekko {
+// Writes a plain-text report to a log directory whenever the game stops
+// producing new frames for a while, crashes, or the player presses
+// Ctrl+Shift+D. Freezes met during normal play are rare and not reproducible
+// on demand, so the report captures everything needed to diagnose one after
+// the fact: the guest registers and call stack, the GPU FIFO pointers, and
+// the native call stack of every thread (as module+offset, resolved offline by
+// tools-src/profiling/resolve_report.py so the game never loads its PDBs).
+//
+// It only reads state. Taking a native stack suspends each thread for the
+// time of a stack copy, which happens only when a report is written.
+class DiagnosticReporter {
+public:
+  struct Options {
+    std::filesystem::path directory;
+    // A frame gap this long counts as a stall. Loading screens keep rendering,
+    // so anything past a couple of seconds is already abnormal.
+    std::chrono::milliseconds stall_threshold{4000};
+    // Caps the reports of one session, should something stall over and over.
+    int max_reports = 20;
+  };
+
+  explicit DiagnosticReporter(Options options);
+  ~DiagnosticReporter();
+
+  DiagnosticReporter(const DiagnosticReporter &) = delete;
+  DiagnosticReporter &operator=(const DiagnosticReporter &) = delete;
+
+private:
+  enum class Trigger { Stall, Manual };
+
+  void WatchLoop(std::stop_token stop_token);
+  bool ManualHotkeyPressed();
+  // Writes a stall or manual report; returns its path (empty if none written).
+  std::filesystem::path WriteReport(Trigger trigger, double seconds_since_frame);
+  void AppendLine(const std::filesystem::path &path, const std::string &line);
+  std::filesystem::path NextReportPath(const char *kind);
+
+  Options m_options;
+  std::mutex m_write_mutex;
+  int m_reports_written = 0;
+  bool m_hotkey_was_down = false;
+
+  // Updated by the present hook on the video thread.
+  std::atomic<std::uint64_t> m_frame_count{0};
+  std::atomic<std::uint64_t> m_present_count{0};
+  std::atomic<std::int64_t> m_last_new_frame_ns{0};
+  Common::EventHook m_present_hook;
+
+  std::jthread m_watch_thread;
+
+  friend struct DiagnosticReporterCrashHandler;
+};
+} // namespace moderngekko
