+// --- crash handler -----------------------------------------------------------
+
+#ifdef MODERNGEKKO_NATIVE_STACKS
+struct DiagnosticReporterCrashHandler {
+  static inline DiagnosticReporter *s_reporter = nullptr;
+  static inline LPTOP_LEVEL_EXCEPTION_FILTER s_previous = nullptr;
+  static inline std::atomic<bool> s_handling{false};
+
+  static void Install(DiagnosticReporter *reporter) {
+    s_reporter = reporter;
+    s_previous = SetUnhandledExceptionFilter(&Filter);
+  }
+
+  static void Uninstall() {
+    SetUnhandledExceptionFilter(s_previous);
+    s_reporter = nullptr;
+  }
+
+  static LONG WINAPI Filter(EXCEPTION_POINTERS *exception) {
+    // Only the first crashing thread reports; a crash inside the report is
+    // left to the default handler.
+    if (s_reporter && !s_handling.exchange(true))
+      WriteCrashReport(*s_reporter, *exception);
+    return s_previous ? s_previous(exception) : EXCEPTION_CONTINUE_SEARCH;
+  }
+
+  static void WriteCrashReport(DiagnosticReporter &reporter, const EXCEPTION_POINTERS &exception) {
+    const EXCEPTION_RECORD &record = *exception.ExceptionRecord;
+    std::map<std::string, std::string> modules;
+    std::string out = fmt::format("Crash report, {}\n\n[exception]\n  code {:08x} at {}\n",
+                                  LocalTimestamp("%Y-%m-%d %H:%M:%S"),
+                                  static_cast<std::uint32_t>(record.ExceptionCode),
+                                  DescribeAddress(reinterpret_cast<std::uintptr_t>(record.ExceptionAddress), modules));
+    if (record.ExceptionCode == EXCEPTION_ACCESS_VIOLATION && record.NumberParameters >= 2) {
+      static constexpr const char *kAccess[] = {"reading", "writing", "?", "?", "?", "?", "?", "?",
+                                                "executing"};
+      fmt::format_to(std::back_inserter(out), "  access violation {} 0x{:016x}\n",
+                     kAccess[std::min<ULONG_PTR>(record.ExceptionInformation[0], 8)],
+                     record.ExceptionInformation[1]);
+    }
+    fmt::format_to(std::back_inserter(out), "  crashing thread {}\n\n",
+                   GetCurrentThreadId());
+    fmt::format_to(std::back_inserter(out), "last new frame {:.1f} s ago, frame {}, present {}\n",
+                   (NowNs() - reporter.m_last_new_frame_ns.load()) / 1e9,
+                   reporter.m_frame_count.load(), reporter.m_present_count.load());
+    DescribeSample(Core::System::GetInstance(), exception.ContextRecord, out, modules);
+    DescribeModules(modules, out);
+    const std::filesystem::path path = reporter.NextReportPath("crash");
+    if (WriteText(path, out))
+      std::fprintf(stderr, "[diagnostics] crash report written to %s\n", path.string().c_str());
+  }
+};
+#endif
+
+// --- reporter ----------------------------------------------------------------
+
+DiagnosticReporter::DiagnosticReporter(Options options) : m_options(std::move(options)) {
+  m_present_hook = GetVideoEvents().after_present_event.Register([this](const PresentInfo &info) {
+    m_present_count.store(info.present_count, std::memory_order_relaxed);
+    if (info.frame_count != m_frame_count.load(std::memory_order_relaxed)) {
+      m_frame_count.store(info.frame_count, std::memory_order_relaxed);
+      m_last_new_frame_ns.store(NowNs(), std::memory_order_relaxed);
+    }
+  });
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  DiagnosticReporterCrashHandler::Install(this);
+#endif
+  m_watch_thread = std::jthread([this](std::stop_token stop_token) { WatchLoop(stop_token); });
+}
+
+DiagnosticReporter::~DiagnosticReporter() {
+  m_watch_thread.request_stop();
+  if (m_watch_thread.joinable())
+    m_watch_thread.join();
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  DiagnosticReporterCrashHandler::Uninstall();
+#endif
+  m_present_hook = {};
+}
+
+void DiagnosticReporter::WatchLoop(std::stop_token stop_token) {
+  Core::System &system = Core::System::GetInstance();
+  const std::int64_t threshold_ns =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(m_options.stall_threshold).count();
+  // Pauses (menus that stop the core, focus loss, savestate loads) are not
+  // stalls: time spent not running moves the baseline forward.
+  std::int64_t not_running_until_ns = 0;
+  std::filesystem::path open_stall_report;
+  std::int64_t stalled_frame_ns = 0;
+
+  while (!stop_token.stop_requested()) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    const std::int64_t now = NowNs();
+
+    if (ManualHotkeyPressed()) {
+      const std::int64_t last = m_last_new_frame_ns.load(std::memory_order_relaxed);
+      WriteReport(Trigger::Manual, last ? (now - last) / 1e9 : 0.0);
+    }
+
+    if (Core::GetState(system) != Core::State::Running) {
+      not_running_until_ns = now;
+      continue;
+    }
+    const std::int64_t last_frame = m_last_new_frame_ns.load(std::memory_order_relaxed);
+    if (last_frame == 0)
+      continue;  // still booting: no frame yet
+
+    if (!open_stall_report.empty()) {
+      if (last_frame != stalled_frame_ns) {
+        AppendLine(open_stall_report,
+                   fmt::format("\nframes resumed: the gap lasted {:.2f} s\n",
+                               (last_frame - stalled_frame_ns) / 1e9));
+        open_stall_report.clear();
+      }
+      continue;
+    }
+    const std::int64_t baseline = std::max(last_frame, not_running_until_ns);
+    if (now - baseline >= threshold_ns) {
+      stalled_frame_ns = last_frame;
+      open_stall_report = WriteReport(Trigger::Stall, (now - last_frame) / 1e9);
+      if (open_stall_report.empty())
+        not_running_until_ns = now;  // capped or failed: do not retry every tick
+    }
+  }
+}
+
+bool DiagnosticReporter::ManualHotkeyPressed() {
+#ifdef _WIN32
+  // Only while the game window has focus, so typing elsewhere never triggers it.
+  DWORD foreground_process = 0;
+  GetWindowThreadProcessId(GetForegroundWindow(), &foreground_process);
+  const bool down = foreground_process == GetCurrentProcessId() &&
+                    (GetAsyncKeyState(VK_CONTROL) & 0x8000) &&
+                    (GetAsyncKeyState(VK_SHIFT) & 0x8000) && (GetAsyncKeyState('D') & 0x8000);
+  const bool pressed = down && !m_hotkey_was_down;
+  m_hotkey_was_down = down;
+  return pressed;
+#else
+  return false;
+#endif
+}
+
+std::filesystem::path DiagnosticReporter::NextReportPath(const char *kind) {
+  return m_options.directory /
+         fmt::format("{}-{}.txt", kind, LocalTimestamp("%Y%m%d-%H%M%S"));
+}
+
+std::filesystem::path DiagnosticReporter::WriteReport(Trigger trigger, double seconds_since_frame) {
+  std::lock_guard lock(m_write_mutex);
+  if (m_reports_written >= m_options.max_reports)
+    return {};
+  ++m_reports_written;
+
+  Core::System &system = Core::System::GetInstance();
+  const bool stall = trigger == Trigger::Stall;
+  std::map<std::string, std::string> modules;
+  std::string out = fmt::format(
+      "{} report, {}\n\nlast new frame {:.1f} s ago, frame {}, present {}\n",
+      stall ? "Stall" : "Manual", LocalTimestamp("%Y-%m-%d %H:%M:%S"), seconds_since_frame,
+      m_frame_count.load(), m_present_count.load());
+  // A stall is sampled a few times: what changes between samples tells a busy
+  // loop from a thread blocked on a wait.
+  const int samples = stall ? 3 : 1;
+  const std::uint64_t presents_before = m_present_count.load();
+  for (int sample = 0; sample < samples; ++sample) {
+    if (sample > 0)
+      std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    fmt::format_to(std::back_inserter(out), "\n===== sample {} of {} =====\n", sample + 1, samples);
+    DescribeSample(system, nullptr, out, modules);
+  }
+  if (stall) {
+    fmt::format_to(std::back_inserter(out),
+                   "\npresents during sampling: {} (non-zero: video interface still ticking, "
+                   "so emulated time advances)\n",
+                   m_present_count.load() - presents_before);
+  }
+  DescribeModules(modules, out);
+
+  const std::filesystem::path path = NextReportPath(stall ? "stall" : "manual");
+  if (!WriteText(path, out))
+    return {};
+  std::fprintf(stderr, "[diagnostics] %s report written to %s\n", stall ? "stall" : "manual",
+               path.string().c_str());
+  return path;
+}
+
+void DiagnosticReporter::AppendLine(const std::filesystem::path &path, const std::string &line) {
+  std::lock_guard lock(m_write_mutex);
+  std::ofstream file(path, std::ios::binary | std::ios::app);
+  file << line;
+}
+} // namespace moderngekko
