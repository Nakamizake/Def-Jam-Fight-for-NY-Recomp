+// --- GPU FIFO ----------------------------------------------------------------
+
+void DescribeBytes(const char *label, const u8 *data, std::size_t size, std::string &out) {
+  fmt::format_to(std::back_inserter(out), "  {}:\n", label);
+  for (std::size_t row = 0; row < size; row += 32) {
+    out += "    ";
+    for (std::size_t i = row; i < std::min(size, row + 32); ++i)
+      fmt::format_to(std::back_inserter(out), "{:02x}{}", data[i], (i % 4 == 3) ? " " : "");
+    out += '\n';
+  }
+}
+
+void DescribeFifo(Core::System &system, std::string &out) {
+  auto &command_processor = system.GetCommandProcessor();
+  const auto &fifo = command_processor.GetFifo();
+  const auto &processor_interface = system.GetProcessorInterface();
+  const auto load = [](const std::atomic<u32> &value) {
+    return value.load(std::memory_order_relaxed);
+  };
+  fmt::format_to(std::back_inserter(out),
+                 "  CP base {:08x}  end {:08x}  read {:08x}  write {:08x}  distance {:08x}\n"
+                 "  CP breakpoint {:08x}  hi watermark {:08x}  lo watermark {:08x}\n"
+                 "  flags: link {} read-enable {} bp-enable {} bp-int {} at-bp {} "
+                 "hi-wm {} (int {}) lo-wm {} (int {})  interrupt waiting {}\n"
+                 "  PI base {:08x}  end {:08x}  write {:08x}{}\n"
+                 "  video buffer: {} bytes copied but not decoded yet\n",
+                 load(fifo.CPBase), load(fifo.CPEnd), load(fifo.CPReadPointer),
+                 load(fifo.CPWritePointer), load(fifo.CPReadWriteDistance),
+                 load(fifo.CPBreakpoint), fifo.CPHiWatermark, fifo.CPLoWatermark,
+                 load(fifo.bFF_GPLinkEnable), load(fifo.bFF_GPReadEnable),
+                 load(fifo.bFF_BPEnable), load(fifo.bFF_BPInt), load(fifo.bFF_Breakpoint),
+                 load(fifo.bFF_HiWatermark), load(fifo.bFF_HiWatermarkInt),
+                 load(fifo.bFF_LoWatermark), load(fifo.bFF_LoWatermarkInt),
+                 command_processor.IsInterruptWaiting(), processor_interface.m_fifo_cpu_base,
+                 processor_interface.m_fifo_cpu_end, processor_interface.m_fifo_cpu_write_pointer,
+                 processor_interface.m_fifo_cpu_write_pointer == load(fifo.CPWritePointer) ?
+                     "" :
+                     "  (differs from CP write)",
+                 system.GetFifo().PendingVideoBufferBytesForDiagnostics());
+
+  // The bytes around the stall point: the command the decoder is stuck on, and
+  // the FIFO memory just before the read pointer (what it consumed last).
+  const std::size_t pending = system.GetFifo().PendingVideoBufferBytesForDiagnostics();
+  if (pending > 0 && pending < (64u << 20))
+    DescribeBytes("pending video data", system.GetFifo().PendingVideoBufferForDiagnostics(),
+                  std::min<std::size_t>(pending, 96), out);
+  if (g_static_recomp_core) {
+    const CPUState &cpu = g_static_recomp_core->GuestStateForDiagnostics();
+    const u32 read = load(fifo.CPReadPointer);
+    const u32 start = read >= 96 ? read - 96 : 0;
+    if (cpu.ram && read <= cpu.ram_size)
+      DescribeBytes(fmt::format("FIFO memory {:08x}..{:08x}", start, read).c_str(), cpu.ram + start,
+                    read - start, out);
+  }
+}
