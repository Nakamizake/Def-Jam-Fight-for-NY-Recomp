--- a/ModernGekko/src/runtime/vi_locked_alarm.hpp
+++ b/ModernGekko/src/runtime/vi_locked_alarm.hpp
@@ -29,20 +29,35 @@ namespace moderngekko {
 // drift into the frame loop's check; the game runs 0.1% slower (59.94 steps a second instead
 // of 60), which nobody can see.
 //
+// Where in the field the step should come depends on the frame loop: it has to be away from
+// the check, whose position moves with the scene and the CPU overclock (a phase that was
+// perfect at 2x in one arena judders at 3x in another). With the game's step queue known, the
+// lock follows the loop: a step still queued when a field ends means that frame's check came
+// before it, and when that is so in some fields of a short window but not in others (the check
+// moving back and forth across the step) the step is moved 1 ms earlier, until the check finds
+// it waiting in every frame.
+//
 // Off unless Core.ViLockedAlarm names the alarm (MainSettings.h), normally in the game's ini.
 class ViLockedAlarm {
 public:
   struct Options {
     std::uint32_t address;   // the OSAlarm struct in guest RAM
     std::uint32_t per_field; // firings per field
-    std::uint32_t phase_us;  // first firing, after the field ends
+    // When the step is queued, after the field ends. With the divider, the firing that queues
+    // it is the first one at or after this point; without it, the first firing is here.
+    std::uint32_t phase_us;
     // Optional: a float the game divides the alarm by (a counter it adds a fraction to on
     // every firing and acts on when it reaches 1), found at *divider_pointer + divider_offset
     // and set to divider_value at every field end, so the game acts on the same firing of
     // each field instead of on either of them depending on where the counter happened to be.
+    // divider_value is the value that makes the first firing of a field act; the game is
+    // expected to add 1 / per_field per firing (one step per field).
     std::uint32_t divider_pointer;
     std::uint32_t divider_offset;
     float divider_value;
+    // Optional, in the same object: the u32 count of steps queued and not run yet (0 = keep
+    // phase_us fixed). Needs the divider.
+    std::uint32_t queue_offset;
   };
 
   // Reads the Core.ViLockedAlarm* settings; returns the options when the lock is on.
@@ -56,9 +71,21 @@ public:
 
 private:
   void OnFieldEnd();
-  void ResetDivider(Memory::MemoryManager &memory) const;
+  // The game object holding the divider and the queue, or 0 while it does not exist.
+  std::uint32_t GameObject(const Memory::MemoryManager &memory) const;
+  void ResetDivider(Memory::MemoryManager &memory, std::uint32_t object,
+                    std::uint64_t firing) const;
+  void FollowFrameLoop(const Memory::MemoryManager &memory, std::uint32_t object,
+                       std::uint64_t field, std::uint64_t ticks_per_second);
 
   Options m_options;
   Common::EventHook m_field_hook;
+  // Timebase ticks after a field's end at which the step is queued; set at the first field.
+  std::optional<std::uint64_t> m_step_phase;
+  // Fields so far (for the log), and FollowFrameLoop's window: fields seen, and fields that
+  // ended with a step still queued.
+  std::uint64_t m_fields = 0;
+  std::uint32_t m_window_fields = 0;
+  std::uint32_t m_window_late = 0;
 };
 } // namespace moderngekko
