+// Reset Game's request: its presence alone asks the runner to boot the game
+// again once this session has ended.
+bool WriteRestartRequest()
+{
+  const std::string path = File::GetUserPath(D_USER_IDX) + "restart-request.ini";
+  std::ofstream out(path, std::ios::trunc);
+  if (!out)
+    return false;
+  out << "[Restart]\n";
+  out.close();
+  return static_cast<bool>(out);
+}
