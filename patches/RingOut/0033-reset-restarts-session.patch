+// Consume <userdir>/restart-request.ini, which the in-game menu's Reset Game
+// leaves: true when the session should be booted again. Deleted first, like the
+// replay request, so it can never fire twice.
+bool ConsumeRestartRequest(const std::filesystem::path &user_directory) {
+  const std::filesystem::path request_path =
+      user_directory / "restart-request.ini";
+  std::error_code ec;
+  if (!std::filesystem::is_regular_file(request_path, ec))
+    return false;
+  return std::filesystem::remove(request_path, ec);
+}
