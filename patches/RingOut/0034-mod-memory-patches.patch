+// One line of a patches.txt: `<address> <new bytes> <bytes expected there>`, the
+// address and both byte strings in hex, the two strings the same length, e.g.
+//   80297D54 00 61   # first letter of "arewecuttin"
+// Blank lines and anything after '#' are ignored.
+struct MemoryPatch
+{
+  std::uint32_t address = 0;
+  std::vector<std::uint8_t> value;
+  std::vector<std::uint8_t> original;
+};
+
+// The patches in a patches.txt; each line that cannot be read is skipped and
