+std::vector<MemoryPatch> ReadMemoryPatches(const std::string& path,
+                                           std::vector<std::string>* errors)
+{
+  std::vector<MemoryPatch> patches;
+  std::ifstream file(std::filesystem::path(StringToPath(path)));
+  std::string line;
+  for (int number = 1; std::getline(file, line); ++number)
+  {
+    line = line.substr(0, line.find('#'));
+    std::istringstream fields(line);
+    std::string address, value, original, extra;
+    if (!(fields >> address))
+      continue;
+    MemoryPatch patch;
+    const auto new_bytes = (fields >> value) ? ParseHexBytes(value) : std::nullopt;
+    const auto old_bytes = (fields >> original) ? ParseHexBytes(original) : std::nullopt;
+    const bool parsed = TryParse(address.starts_with("0x") ? address : "0x" + address,
+                                 &patch.address) &&
+                        new_bytes && old_bytes && !(fields >> extra);
+    // MEM1 only: the game's code and data are there, and nothing else may be written.
+    if (!parsed || new_bytes->size() != old_bytes->size() || patch.address < 0x80000000 ||
+        patch.address + new_bytes->size() > 0x81800000)
+    {
+      errors->push_back(fmt::format("line {}: expected '<address> <new bytes> <old bytes>' "
+                                    "(hex, same length, in 80000000-817FFFFF)",
+                                    number));
+      continue;
+    }
+    patch.value = *new_bytes;
+    patch.original = *old_bytes;
+    patches.push_back(std::move(patch));
+  }
+  return patches;
+}
