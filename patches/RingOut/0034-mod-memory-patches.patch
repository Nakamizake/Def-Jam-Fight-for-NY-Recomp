+// The mod's patches.txt: at its top, or one level down like files/.
+std::filesystem::path FindPatchesFile(const std::filesystem::path& folder)
+{
+  std::error_code ec;
+  std::vector<std::filesystem::path> subfolders;
+  for (const auto& entry : std::filesystem::directory_iterator(folder, ec))
+  {
+    std::string name = entry.path().filename().string();
+    for (char& c : name)
+      c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    if (entry.is_regular_file(ec) && name == "patches.txt")
+      return entry.path();
+    if (entry.is_directory(ec))
+      subfolders.push_back(entry.path());
+  }
+  if (subfolders.size() == 1)
+  {
+    const std::filesystem::path inner = subfolders.front() / "patches.txt";
+    if (std::filesystem::is_regular_file(inner, ec))
+      return inner;
+  }
+  return {};
+}
+
+std::optional<std::vector<std::uint8_t>> ParseHexBytes(std::string_view text)
+{
+  if (text.empty() || text.size() % 2 != 0)
+    return std::nullopt;
+  std::vector<std::uint8_t> bytes;
+  for (size_t i = 0; i < text.size(); i += 2)
+  {
+    u32 byte = 0;
+    if (!TryParse(std::string("0x") + std::string(text.substr(i, 2)), &byte))
+      return std::nullopt;
+    bytes.push_back(static_cast<std::uint8_t>(byte));
+  }
+  return bytes;
+}
