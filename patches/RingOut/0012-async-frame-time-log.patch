 #include <utility>
 
+#include <fmt/format.h>
 #include <implot.h>
 
 #include "Common/CommonTypes.h"
@@ -189,11 +190,24 @@ void PerformanceTracker::LogRenderTimeToFile(DT val)
   if (!m_log_name || !g_ActiveConfig.bLogRenderTimeToFile)
     return;
 
+  // A write can block for hundreds of milliseconds (a slow disk busy flushing the file), and this
+  // runs on the thread that presents frames: hand the line to a thread of its own instead.
+  if (!m_log_writer.IsRunning())
+  {
+    m_log_writer.Reset("Performance log: " + *m_log_name,
+                       [this](std::string line) { WriteLogLine(line); });
+  }
+  m_log_writer.Push(fmt::format("{:.8f}\n", DT_ms(val).count()));
+}
+
+void PerformanceTracker::WriteLogLine(const std::string& line)
+{
   if (!m_bench_file.is_open())
   {
     File::OpenFStream(m_bench_file, File::GetUserPath(D_LOGS_IDX) + *m_log_name,
                       std::ios_base::out);
   }
 
-  m_bench_file << std::fixed << std::setprecision(8) << DT_ms(val).count() << std::endl;
+  // Flushed line by line, so a game that is killed still leaves a complete log behind.
+  m_bench_file << line << std::flush;
 }
