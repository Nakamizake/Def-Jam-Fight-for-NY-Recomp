+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// RingOut: control layouts for the emulated GameCube pads.
+//
+// A layout is an ordinary Dolphin GCPad profile (Config/Profiles/GCPad/<name>.ini) that a game
+// port ships to reproduce how one console release of the game was played -- the PlayStation 2
+// release's buttons on a DualSense, the Xbox release's on an Xbox pad. Each port remembers a
+// CHOICE: a layout by name, "Auto" (the layout named after the console whose pad is plugged in),
+// or "Custom" (the bindings as the player left them; set by rebinding a button by hand).
+//
+// Loading a layout replaces the pad's bindings but keeps its device. Bindings are host-side, so
+// layouts never affect netplay or determinism.
+
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace RecompPadLayout
+{
+inline constexpr std::string_view kAuto = "Auto";
+inline constexpr std::string_view kCustom = "Custom";
+
+// The layouts on offer, by name, sorted.
+std::vector<std::string> Available();
+
+// What a port (0-based) is set to: kAuto, kCustom or a layout name.
+std::string GetChoice(int port);
+// Records the choice in the base config layer; the caller saves the config.
+void SetChoice(int port, const std::string& choice);
+
+// The layout Auto picks for a device ("SDL/0/DualSense Wireless Controller"): the one named
+// after the console its buttons are printed like, or empty when there is none for it (a
+// keyboard, or a pad whose console has no layout).
+std::string AutoLayoutFor(const std::string& device);
+
+// The layout a port's choice resolves to on its current device; empty for "leave it alone".
+std::string Resolve(int port);
+
+// Loads the resolved layout onto a port's pad, keeping its device, and saves the pad config.
+// Returns the layout loaded, or empty when the choice resolved to nothing or the file is gone.
+// Touches InputConfig: never call it with a lock the CPU or video thread may wait on.
+std::string Apply(int port);
+
+// Apply for every port; called once the controllers are up at boot.
+void ApplyAll();
+}  // namespace RecompPadLayout
