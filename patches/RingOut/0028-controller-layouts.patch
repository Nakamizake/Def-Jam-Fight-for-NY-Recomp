+// Reads the configured port's layout state. Touches InputConfig and the device
+// list, so like BuildDeviceListData it must run with the menu mutex released.
+LayoutSnapshot BuildLayoutData()
+{
+  LayoutSnapshot layout;
+  const int port = s_config_port.load(std::memory_order_relaxed);
+  layout.available = RecompPadLayout::Available();
+  layout.choice = RecompPadLayout::GetChoice(port);
+  if (auto* const pad = GetConfiguredPad())
+    layout.auto_layout = RecompPadLayout::AutoLayoutFor(pad->GetDefaultDevice().ToString());
+  return layout;
+}
+
+// Auto, each layout, then Custom -- which loads nothing, it only stops Auto
+// from replacing bindings the player is about to change.
+std::string CycleLayout(const LayoutSnapshot& layout, int direction)
+{
+  std::vector<std::string> options{std::string(RecompPadLayout::kAuto)};
+  options.insert(options.end(), layout.available.begin(), layout.available.end());
+  options.emplace_back(RecompPadLayout::kCustom);
+  const auto iter = std::ranges::find(options, layout.choice);
+  const int index = iter == options.end() ? 0 : static_cast<int>(iter - options.begin());
+  const int count = static_cast<int>(options.size());
+  return options[(index + direction + count) % count];
+}
+
+std::string LayoutLabel(const LayoutSnapshot& layout)
+{
+  std::string label;
+  if (layout.choice == RecompPadLayout::kAuto)
+    label = "AUTO: " + (layout.auto_layout.empty() ? std::string("NONE") :
+                                                     layout.auto_layout);
+  else
+    label = layout.choice;
+  std::ranges::transform(label, label.begin(),
+                         [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+  return label;
+}
