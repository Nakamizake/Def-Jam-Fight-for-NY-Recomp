diff --git a/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompPadLayout.cpp b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompPadLayout.cpp
new file mode 100644
index 00000000..699a8cb5
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompPadLayout.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoCommon/RecompPadLayout.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <system_error>
+
+#include "Common/Config/Config.h"
+#include "Common/IniFile.h"
+#include "Common/StringUtil.h"
+#include "Core/HW/GCPad.h"
+#include "InputCommon/ControllerEmu/ControllerEmu.h"
+#include "InputCommon/ControllerInterface/ControllerInterface.h"
+#include "InputCommon/ControllerInterface/CoreDevice.h"
+#include "InputCommon/InputConfig.h"
+
+namespace RecompPadLayout
+{
+namespace
+{
+using ButtonLabels = ciface::Core::Device::ButtonLabels;
+
+const std::array<Config::Info<std::string>, 2> CHOICE{{
+    {{Config::System::Main, "RecompMenu", "PadLayout1"}, std::string(kAuto)},
+    {{Config::System::Main, "RecompMenu", "PadLayout2"}, std::string(kAuto)},
+}};
+
+bool IsValidPort(int port)
+{
+  return port >= 0 && port < static_cast<int>(CHOICE.size());
+}
+
+std::filesystem::path LayoutDirectory()
+{
+  InputConfig* const config = Pad::GetConfig();
+  return config != nullptr ? StringToPath(config->GetUserProfileDirectoryPath()) :
+                             std::filesystem::path();
+}
+
+std::filesystem::path LayoutPath(const std::string& name)
+{
+  return LayoutDirectory() / StringToPath(name + ".ini");
+}
+
+// A Switch pad has its face buttons where a GameCube pad has its own (the big button at the
+// bottom, the narrow ones beside it), so it plays the GameCube layout.
+const char* LayoutNameFor(ButtonLabels labels)
+{
+  switch (labels)
+  {
+  case ButtonLabels::PlayStation:
+    return "PlayStation";
+  case ButtonLabels::Xbox:
+    return "Xbox";
+  case ButtonLabels::NintendoSwitch:
+  case ButtonLabels::GameCube:
+    return "GameCube";
+  default:
+    return nullptr;
+  }
+}
+}  // namespace
+
+std::vector<std::string> Available()
+{
+  std::vector<std::string> names;
+  std::error_code ec;
+  const std::filesystem::path directory = LayoutDirectory();
+  if (directory.empty())
+    return names;
+  for (const auto& entry : std::filesystem::directory_iterator(directory, ec))
+  {
+    std::error_code type_ec;
+    if (entry.is_regular_file(type_ec) && entry.path().extension() == ".ini")
+      names.push_back(PathToString(entry.path().stem()));
+  }
+  std::ranges::sort(names);
+  return names;
+}
+
+std::string GetChoice(int port)
+{
+  if (!IsValidPort(port))
+    return std::string(kCustom);
+  std::string choice = Config::Get(CHOICE[port]);
+  return choice.empty() ? std::string(kAuto) : choice;
+}
+
+void SetChoice(int port, const std::string& choice)
+{
+  if (IsValidPort(port))
+    Config::SetBase(CHOICE[port], choice);
+}
+
+std::string AutoLayoutFor(const std::string& device)
+{
+  ciface::Core::DeviceQualifier qualifier;
+  qualifier.FromString(device);
+  const std::shared_ptr<ciface::Core::Device> found = g_controller_interface.FindDevice(qualifier);
+  if (found == nullptr)
+    return {};
+  const char* const name = LayoutNameFor(found->GetButtonLabels());
+  if (name == nullptr)
+    return {};
+  std::error_code ec;
+  return std::filesystem::is_regular_file(LayoutPath(name), ec) ? name : std::string();
+}
+
+std::string Resolve(int port)
+{
+  InputConfig* const config = Pad::GetConfig();
+  if (config == nullptr || port >= config->GetControllerCount())
+    return {};
+  const std::string choice = GetChoice(port);
+  if (choice == kCustom)
+    return {};
+  if (choice == kAuto)
+    return AutoLayoutFor(config->GetController(port)->GetDefaultDevice().ToString());
+  return choice;
+}
+
+std::string Apply(int port)
+{
+  const std::string name = Resolve(port);
+  if (name.empty())
+    return {};
+
+  Common::IniFile ini;
+  if (!ini.Load(PathToString(LayoutPath(name))))
+  {
+    std::fprintf(stderr, "[input] pad %d: layout '%s' not found\n", port + 1, name.c_str());
+    return {};
+  }
+
+  InputConfig* const config = Pad::GetConfig();
+  ControllerEmu::EmulatedController* const pad = config->GetController(port);
+  // A layout names no device (LoadConfig keeps the current one when the key is absent), but one
+  // saved from Dolphin would: put the pad back on the device it is actually using.
+  const std::string device = pad->GetDefaultDevice().ToString();
+  pad->LoadConfig(ini.GetOrCreateSection("Profile"));
+  pad->SetDefaultDevice(device);
+  pad->UpdateReferences(g_controller_interface);
+  config->SaveConfig();
+  std::fprintf(stderr, "[input] pad %d: %s layout\n", port + 1, name.c_str());
+  return name;
+}
+
+void ApplyAll()
+{
+  InputConfig* const config = Pad::GetConfig();
+  if (config == nullptr)
+    return;
+  const int count = std::min(config->GetControllerCount(), static_cast<int>(CHOICE.size()));
+  for (int port = 0; port < count; ++port)
+  {
+    // A port nobody configured (port 2 starts blank) has no device to pick a layout for.
+    if (!config->GetController(port)->GetDefaultDevice().ToString().empty())
+      Apply(port);
+  }
+}
+}  // namespace RecompPadLayout
