--- a/ModernGekko/vendor/dolphin/Source/Core/Core/CoreTiming.cpp
+++ b/ModernGekko/vendor/dolphin/Source/Core/Core/CoreTiming.cpp
@@ -579,6 +579,16 @@ void CoreTimingManager::Idle()
     // the VI will be desynchronized. So, We are waiting until the FIFO finish and
     // while we process only the events required by the FIFO.
     m_system.GetFifo().FlushGpu();
+
+    // Draining the FIFO can raise interrupts (watermarks, PE token/finish) through events the
+    // GPU thread queues for the CPU thread. They are due now: idling away the rest of the slice
+    // would deliver them only at its end, so a game that waits on the GPU many times per frame
+    // loses a slice of emulated time on every wait. End the slice here instead.
+    if (!m_ts_queue.Empty())
+    {
+      ForceExceptionCheck(0);
+      return;
+    }
   }
 
   auto& ppc_state = m_system.GetPPCState();
