diff --git a/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.cpp b/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.cpp
new file mode 100644
index 00000000..b90f6956
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.cpp
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/HitchTrace.h"
+
+#include <algorithm>
+#include <bit>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+#include "Common/Thread.h"
+
+#ifdef _WIN32
+#include <Windows.h>
+#include <intrin.h>
+#else
+#include <time.h>
+#endif
+
+namespace Common::HitchTrace
+{
+namespace Detail
+{
+std::atomic<bool> g_enabled{false};
+}
+
+namespace
+{
+// Shorter spans are not worth a slot: they would only push older events out of the ring.
+constexpr s64 MIN_SPAN_NS = 10'000;
+constexpr u32 MAX_DETAIL = (1u << 24) - 1;
+
+// Written by any thread, read by Collect() on another one without locking: the sequence number
+// tells a reader whether the slot changed under it (odd while a write is in progress).
+struct Slot
+{
+  std::atomic<u64> sequence{0};  // 0 = never written, else 2 * write index + 1 or + 2
+  std::atomic<s64> start_ns{0};
+  std::atomic<s64> end_ns{0};
+  std::atomic<u64> info{0};  // thread id << 32 | span << 24 | detail
+};
+
+std::unique_ptr<Slot[]> s_slots;
+std::size_t s_mask = 0;
+std::atomic<u64> s_next_write{0};
+std::once_flag s_enable_once;
+
+#ifdef _WIN32
+// QueryThreadCycleTime counts time-stamp counter ticks; measured once against the steady clock.
+double s_ns_per_cycle = 0.0;
+
+void CalibrateCycleClock()
+{
+  const u64 cycles_before = __rdtsc();
+  const s64 ns_before = NowNs();
+  std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  const u64 cycles = __rdtsc() - cycles_before;
+  const s64 ns = NowNs() - ns_before;
+  if (cycles > 0)
+    s_ns_per_cycle = static_cast<double>(ns) / static_cast<double>(cycles);
+}
+#endif
+}  // namespace
+
+const char* GetName(Span span)
+{
+  switch (span)
+  {
+  case Span::ThrottleSleep:
+    return "ThrottleSleep";
+  case Span::GpuFlush:
+    return "GpuFlush";
+  case Span::GpuSyncWait:
+    return "GpuSyncWait";
+  case Span::GpuRequestWait:
+    return "GpuRequestWait";
+  case Span::DvdReadWait:
+    return "DvdReadWait";
+  case Span::ViField:
+    return "ViField";
+  case Span::Present:
+    return "Present";
+  case Span::FramePresented:
+    return "FramePresented";
+  case Span::FenceWait:
+    return "FenceWait";
+  case Span::SubmitWait:
+    return "SubmitWait";
+  case Span::AcquireImage:
+    return "AcquireImage";
+  case Span::QueuePresent:
+    return "QueuePresent";
+  case Span::PipelineCompile:
+    return "PipelineCompile";
+  case Span::Count:
+    break;
+  }
+  return "?";
+}
+
+void Enable(std::size_t capacity)
+{
+  std::call_once(s_enable_once, [capacity] {
+    const std::size_t size = std::bit_ceil(std::max<std::size_t>(capacity, 2));
+    s_slots = std::make_unique<Slot[]>(size);
+    s_mask = size - 1;
+#ifdef _WIN32
+    CalibrateCycleClock();
+#endif
+    Detail::g_enabled.store(true, std::memory_order_release);
+  });
+}
+
+s64 NowNs()
+{
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+s64 CurrentThreadBusyNs()
+{
+#ifdef _WIN32
+  ULONG64 cycles = 0;
+  QueryThreadCycleTime(GetCurrentThread(), &cycles);
+  return static_cast<s64>(static_cast<double>(cycles) * s_ns_per_cycle);
+#else
+  timespec time{};
+  clock_gettime(CLOCK_THREAD_CPUTIME_ID, &time);
+  return static_cast<s64>(time.tv_sec) * 1'000'000'000 + time.tv_nsec;
+#endif
+}
+
+void Record(Span span, s64 start_ns, s64 end_ns, u32 detail)
+{
+  if (!Detail::g_enabled.load(std::memory_order_acquire) || end_ns - start_ns < MIN_SPAN_NS)
+    return;
+
+  const u64 index = s_next_write.fetch_add(1, std::memory_order_relaxed);
+  Slot& slot = s_slots[index & s_mask];
+  slot.sequence.store(2 * index + 1, std::memory_order_relaxed);
+  std::atomic_thread_fence(std::memory_order_release);
+  slot.start_ns.store(start_ns, std::memory_order_relaxed);
+  slot.end_ns.store(end_ns, std::memory_order_relaxed);
+  slot.info.store(static_cast<u64>(static_cast<u32>(CurrentThreadId())) << 32 |
+                      static_cast<u64>(span) << 24 | std::min(detail, MAX_DETAIL),
+                  std::memory_order_relaxed);
+  slot.sequence.store(2 * index + 2, std::memory_order_release);
+}
+
+std::vector<Event> Collect(s64 from_ns, s64 to_ns)
+{
+  std::vector<Event> events;
+  if (!Detail::g_enabled.load(std::memory_order_acquire))
+    return events;
+
+  for (std::size_t i = 0; i <= s_mask; ++i)
+  {
+    const Slot& slot = s_slots[i];
+    const u64 sequence = slot.sequence.load(std::memory_order_acquire);
+    if (sequence == 0 || sequence % 2 != 0)
+      continue;
+    const s64 start_ns = slot.start_ns.load(std::memory_order_relaxed);
+    const s64 end_ns = slot.end_ns.load(std::memory_order_relaxed);
+    const u64 info = slot.info.load(std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (slot.sequence.load(std::memory_order_relaxed) != sequence)
+      continue;
+    if (end_ns < from_ns || start_ns > to_ns)
+      continue;
+    events.push_back(Event{
+        .start_ns = start_ns,
+        .end_ns = end_ns,
+        .thread_id = static_cast<u32>(info >> 32),
+        .span = static_cast<Span>((info >> 24) & 0xFF),
+        .detail = static_cast<u32>(info & MAX_DETAIL),
+    });
+  }
+  std::ranges::sort(events, {}, &Event::start_ns);
+  return events;
+}
+}  // namespace Common::HitchTrace
diff --git a/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.h b/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.h
new file mode 100644
index 00000000..3f44ce38
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/Common/HitchTrace.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+// Records where the emulator's threads wait, so a frame that took too long can be explained
+// after the fact: the CPU thread sleeping in the speed limiter, waiting for the GPU thread to
+// drain the FIFO or for a DVD read, the GPU thread waiting on a fence or a present, and so on.
+//
+// Each span is written, once it ends, to a fixed-size ring in memory that a reader (the
+// runtime's hitch recorder) copies out when it sees a slow frame. Recording is off until
+// Enable() is called; while off, a traced span costs one relaxed atomic load.
+namespace Common::HitchTrace
+{
+enum class Span : u8
+{
+  // CPU thread
+  ThrottleSleep,   // speed limiter sleeping until the emulated time catches up with real time
+  GpuFlush,        // idle skip waiting for the GPU thread to drain the FIFO
+  GpuSyncWait,     // "Sync GPU thread" holding the CPU back until the GPU catches up
+  GpuRequestWait,  // a blocking request run on the GPU thread (EFB peek, bounding box, query)
+  DvdReadWait,     // waiting for the DVD thread to finish a read that is due
+  ViField,         // one emulated video field; detail = microseconds the thread was on a core
+
+  // GPU thread
+  Present,         // Presenter::Present, from the XFB copy to handing the frame to the backend
+  FramePresented,  // time since the previous presented frame; detail as for ViField
+
+  // Vulkan backend (GPU thread or its submit worker)
+  FenceWait,        // waiting for a command buffer to finish on the GPU
+  SubmitWait,       // waiting for the submit worker thread to go idle
+  AcquireImage,     // vkAcquireNextImageKHR
+  QueuePresent,     // vkQueuePresentKHR
+  PipelineCompile,  // vkCreateGraphicsPipelines
+
+  Count
+};
+
+const char* GetName(Span span);
+
+struct Event
+{
+  s64 start_ns;
+  s64 end_ns;
+  u32 thread_id;
+  Span span;
+  u32 detail;
+};
+
+namespace Detail
+{
+extern std::atomic<bool> g_enabled;
+}
+
+inline bool IsEnabled()
+{
+  return Detail::g_enabled.load(std::memory_order_relaxed);
+}
+
+// Allocates a ring of at least `capacity` events and starts recording. Call once, before the
+// traced threads start; later calls do nothing.
+void Enable(std::size_t capacity);
+
+// Steady clock, in nanoseconds. Event times use it.
+s64 NowNs();
+
+// Time the calling thread has spent running on a core, in nanoseconds (it does not advance
+// while the thread waits or is preempted). Only meaningful as a difference.
+s64 CurrentThreadBusyNs();
+
+void Record(Span span, s64 start_ns, s64 end_ns, u32 detail = 0);
+
+// Copies out the recorded events that overlap [from_ns, to_ns], oldest first. Events written
+// while the copy runs may be missed.
+std::vector<Event> Collect(s64 from_ns, s64 to_ns);
+
+// Records the lifetime of the object as one span of the calling thread.
+class ScopedSpan
+{
+public:
+  explicit ScopedSpan(Span span) : m_span(span), m_start_ns(IsEnabled() ? NowNs() : 0) {}
+  ~ScopedSpan()
+  {
+    if (m_start_ns != 0)
+      Record(m_span, m_start_ns, NowNs());
+  }
+
+  ScopedSpan(const ScopedSpan&) = delete;
+  ScopedSpan& operator=(const ScopedSpan&) = delete;
+
+private:
+  Span m_span;
+  s64 m_start_ns;
+};
+
+// Runs `function` as one span and returns what it returns.
+template <typename F>
+decltype(auto) Traced(Span span, F&& function)
+{
+  const ScopedSpan trace{span};
+  return std::forward<F>(function)();
+}
+}  // namespace Common::HitchTrace
