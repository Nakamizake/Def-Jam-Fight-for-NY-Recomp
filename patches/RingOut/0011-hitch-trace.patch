@@ -0,0 +1,37 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace moderngekko {
+// Native call stacks of the runtime's own threads, for diagnostic reports. Frames are kept as
+// raw addresses and written as `module+0xoffset`, so the game never loads its PDBs:
+// tools-src/profiling/resolve_report.py turns them into function names offline.
+struct NativeStack {
+  std::uint32_t thread_id = 0;
+  std::string name;
+  std::vector<std::uintptr_t> frames;
+  // Why the stack is missing or incomplete, if it is.
+  std::string note;
+};
+
+// False where capturing is not implemented (anything but x64 Windows built with MSVC); the
+// functions below then return stacks with only a note.
+bool CanCaptureNativeStacks();
+
+// Another thread's stack. The thread is suspended only for the time of a register read and a
+// copy of its used stack, never while unwinding.
+NativeStack CaptureThreadStack(std::uint32_t thread_id);
+
+// Every thread of the process. `current_thread_context` (a Windows CONTEXT, e.g. from a crash)
+// is where to unwind the calling thread from; without it the calling thread gets only a note.
+std::vector<NativeStack> CaptureAllThreadStacks(const void *current_thread_context);
+
+// `module+0xoffset` for a code address, remembering the module's path in `modules`.
+std::string DescribeAddress(std::uintptr_t address, std::map<std::string, std::string> &modules);
+
+// The [modules] section resolve_report.py reads module paths from.
+void DescribeModules(const std::map<std::string, std::string> &modules, std::string &out);
+} // namespace moderngekko
diff --git a/ModernGekko/src/runtime/thread_names.cpp b/ModernGekko/src/runtime/thread_names.cpp
new file mode 100644
index 00000000..609fea3b
--- /dev/null
+++ b/ModernGekko/src/runtime/thread_names.cpp
@@ -0,0 +1,39 @@
+#include "thread_names.hpp"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace moderngekko {
+#ifdef _WIN32
+std::string ThreadName(void *thread_handle) {
+  // Looked up at run time: GetThreadDescription is missing before Windows 10 1607.
+  using GetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PWSTR *);
+  static const auto get_description = reinterpret_cast<GetThreadDescriptionFn>(
+      GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+  if (!get_description)
+    return {};
+  PWSTR wide = nullptr;
+  if (FAILED(get_description(static_cast<HANDLE>(thread_handle), &wide)) || !wide)
+    return {};
+  std::string name;
+  for (const wchar_t *c = wide; *c; ++c)
+    name += *c < 0x80 ? static_cast<char>(*c) : '?';
+  LocalFree(wide);
+  return name;
+}
+
+std::string ThreadNameById(std::uint32_t thread_id) {
+  HANDLE thread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, thread_id);
+  if (!thread)
+    return {};
+  std::string name = ThreadName(thread);
+  CloseHandle(thread);
+  return name;
+}
+#else
+std::string ThreadName(void *) { return {}; }
+
+std::string ThreadNameById(std::uint32_t) { return {}; }
+#endif
+} // namespace moderngekko
diff --git a/ModernGekko/src/runtime/thread_names.hpp b/ModernGekko/src/runtime/thread_names.hpp
new file mode 100644
index 00000000..94cae957
--- /dev/null
+++ b/ModernGekko/src/runtime/thread_names.hpp
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace moderngekko {
+// The name a thread was given with SetThreadDescription (Dolphin names its own threads), or an
+// empty string. `thread_handle` is a Windows HANDLE with query access; other platforms always
+// get an empty string.
+std::string ThreadName(void *thread_handle);
+
+// The same, for a thread of this process given by id.
+std::string ThreadNameById(std::uint32_t thread_id);
+} // namespace moderngekko
