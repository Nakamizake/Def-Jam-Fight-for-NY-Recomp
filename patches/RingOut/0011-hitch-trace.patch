new file mode 100644
index 00000000..b1e3cc84
--- /dev/null
+++ b/ModernGekko/src/runtime/hitch_recorder.hpp
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <stop_token>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "Common/HitchTrace.h"
+#include "Common/HookableEvent.h"
+#include "native_stacks.hpp"
+
+namespace moderngekko {
+// Writes a report to a log directory whenever an emulated video field or a presented frame
+// takes much longer than a frame should. The report lays out the waits Common::HitchTrace
+// recorded around it (what the CPU and GPU threads were waiting on, and for how long), and how
+// long the thread was actually on a core: a slow field with neither waits nor work in it means
+// the thread was preempted or blocked somewhere the trace does not see. For those, the native
+// stacks sampled from the thread while it was stuck show where.
+//
+// Off unless RINGOUT_HITCH_TRACE is set to the threshold in milliseconds.
+class HitchRecorder {
+public:
+  struct Options {
+    std::filesystem::path directory;
+    std::chrono::milliseconds threshold{50};
+    // How much of the trace before and after the slow interval goes into a report.
+    std::chrono::milliseconds context{250};
+    // Caps the reports of one session.
+    int max_reports = 30;
+  };
+
+  // Reads RINGOUT_HITCH_TRACE and, when it asks for reports, starts Common::HitchTrace and
+  // returns the options to build the recorder with. Call it before the emulator starts its
+  // threads, so the trace covers all of them.
+  static std::optional<Options> EnableFromEnvironment(std::filesystem::path directory);
+
+  explicit HitchRecorder(Options options);
+  ~HitchRecorder();
+
+  HitchRecorder(const HitchRecorder &) = delete;
+  HitchRecorder &operator=(const HitchRecorder &) = delete;
+
+private:
+  // One periodic interval of one thread: video fields on the CPU thread, presented frames on
+  // the GPU thread. Written by that thread only; the stack sampler reads the atomics.
+  struct IntervalClock {
+    std::atomic<std::int64_t> start_ns{0};
+    std::atomic<std::uint32_t> thread_id{0};
+    std::int64_t busy_start_ns = 0;
+  };
+
+  struct Hitch {
+    Common::HitchTrace::Span span;
+    std::int64_t start_ns;
+    std::int64_t end_ns;
+    std::int64_t busy_ns;
+  };
+
+  // A native stack of a thread whose interval was already running long, taken while it ran.
+  struct StackSample {
+    Common::HitchTrace::Span span;
+    std::int64_t interval_start_ns;
+    std::int64_t taken_ns;
+    NativeStack stack;
+  };
+
+  void OnIntervalEnd(Common::HitchTrace::Span span, IntervalClock &clock);
+  void SamplerLoop(std::stop_token stop);
+  void WriterLoop(std::stop_token stop);
+  void WriteReport(const Hitch &hitch, const std::vector<StackSample> &samples);
+  const std::string &ThreadLabel(std::uint32_t thread_id);
+
+  Options m_options;
+  std::int64_t m_session_start_ns;
+  std::string m_session_timestamp;
+
+  IntervalClock m_field_clock;
+  IntervalClock m_present_clock;
+
+  std::mutex m_mutex;
+  std::condition_variable_any m_wake;
+  std::deque<Hitch> m_pending;
+  std::deque<StackSample> m_samples;
+
+  // Writer thread only.
+  int m_reports_written = 0;
+  std::map<std::uint32_t, std::string> m_thread_labels;
+
+  Common::EventHook m_field_hook;
+  Common::EventHook m_present_hook;
+  std::jthread m_sampler;
+  std::jthread m_writer;
+};
+} // namespace moderngekko
diff --git a/ModernGekko/src/runtime/native_stacks.cpp b/ModernGekko/src/runtime/native_stacks.cpp
new file mode 100644
index 00000000..ae0f6bea
--- /dev/null
+++ b/ModernGekko/src/runtime/native_stacks.cpp
@@ -0,0 +1,262 @@
+#include "native_stacks.hpp"
+
+#include <algorithm>
+#include <cstring>
+#include <iterator>
+#include <optional>
+
+#include <fmt/format.h>
+
+#include "thread_names.hpp"
+
+#if defined(_WIN32) && defined(_M_X64) && defined(_MSC_VER)
+#define MODERNGEKKO_NATIVE_STACKS 1
+#include <windows.h>
+#include <tlhelp32.h>
+#endif
+
+namespace moderngekko {
+namespace {
+#ifdef MODERNGEKKO_NATIVE_STACKS
+constexpr int kMaxNativeFrames = 64;
+constexpr std::size_t kMaxStackCopy = 4 * 1024 * 1024;
+
+// The SEH helpers below hold no C++ objects, which __try requires.
+bool CopyMemorySafely(void *destination, const void *source, std::size_t size) {
+  __try {
+    std::memcpy(destination, source, size);
+    return true;
+  } __except (EXCEPTION_EXECUTE_HANDLER) {
+    return false;
+  }
+}
+
+// Unwinds `context` with the x64 unwind tables, keeping rsp inside
+// [stack_low, stack_high). Code without unwind data (JIT output) is treated as
+// a leaf, which is right for leaves and ends the walk early otherwise.
+int UnwindFrames(CONTEXT *context, std::uintptr_t stack_low, std::uintptr_t stack_high,
+                 std::uintptr_t *frames, int max_frames) {
+  int count = 0;
+  __try {
+    while (count < max_frames && context->Rip != 0) {
+      frames[count++] = context->Rip;
+      if (context->Rsp < stack_low || context->Rsp + 8 > stack_high)
+        break;
+      DWORD64 image_base = 0;
+      PRUNTIME_FUNCTION function = RtlLookupFunctionEntry(context->Rip, &image_base, nullptr);
+      if (!function) {
+        context->Rip = *reinterpret_cast<const DWORD64 *>(context->Rsp);
+        context->Rsp += 8;
+        continue;
+      }
+      void *handler_data = nullptr;
+      DWORD64 establisher_frame = 0;
+      RtlVirtualUnwind(UNW_FLAG_NHANDLER, image_base, context->Rip, function, context,
+                       &handler_data, &establisher_frame, nullptr);
+    }
+  } __except (EXCEPTION_EXECUTE_HANDLER) {
+  }
+  return count;
+}
+
+// Stack range of another thread, from its TEB (NT_TIB.StackLimit/StackBase).
+bool ThreadStackRange(HANDLE thread, std::uintptr_t *low, std::uintptr_t *high) {
+  struct ThreadBasicInformation {
+    LONG exit_status;
+    PVOID teb;
+    HANDLE process_id;
+    HANDLE thread_id;
+    ULONG_PTR affinity;
+    LONG priority;
+    LONG base_priority;
+  };
+  using NtQueryInformationThreadFn = LONG(NTAPI *)(HANDLE, int, PVOID, ULONG, PULONG);
+  static const auto query = reinterpret_cast<NtQueryInformationThreadFn>(
+      GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtQueryInformationThread"));
+  ThreadBasicInformation info{};
+  if (!query || query(thread, 0 /* ThreadBasicInformation */, &info, sizeof(info), nullptr) < 0 ||
+      !info.teb)
+    return false;
+  const NT_TIB *tib = static_cast<const NT_TIB *>(info.teb);
+  *low = reinterpret_cast<std::uintptr_t>(tib->StackLimit);
+  *high = reinterpret_cast<std::uintptr_t>(tib->StackBase);
+  return *low < *high;
+}
+
+// Captures another thread's stack without unwinding it in place: the thread is
+// suspended only long enough to read its registers and copy its used stack,
+// because the unwinder takes loader locks a suspended thread might hold. The
+// copy is then unwound with stack pointers rebased onto it.
+void CaptureOtherThread(DWORD thread_id, std::vector<std::uint8_t> &buffer, NativeStack &stack) {
+  HANDLE thread = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION,
+                             FALSE, thread_id);
+  if (!thread) {
+    stack.note = "could not open thread";
+    return;
+  }
+  stack.name = ThreadName(thread);
+  std::uintptr_t stack_low = 0, stack_high = 0;
+  if (!ThreadStackRange(thread, &stack_low, &stack_high)) {
+    stack.note = "could not read stack range";
+    CloseHandle(thread);
+    return;
+  }
+
+  CONTEXT context{};
+  context.ContextFlags = CONTEXT_FULL;
+  std::size_t copied = 0;
+  bool captured = false;
+  if (SuspendThread(thread) != static_cast<DWORD>(-1)) {
+    if (GetThreadContext(thread, &context) && context.Rsp >= stack_low && context.Rsp < stack_high) {
+      copied = std::min<std::size_t>(stack_high - context.Rsp, buffer.size());
+      captured = CopyMemorySafely(buffer.data(), reinterpret_cast<const void *>(context.Rsp), copied);
+    }
+    ResumeThread(thread);
+  }
+  CloseHandle(thread);
+  if (!captured) {
+    stack.note = "could not capture registers or stack";
+    return;
+  }
+
+  // Rebase every pointer into the original stack (saved frame pointers,
+  // registers) onto the copy, so the unwinder never reads the live stack.
+  const std::uintptr_t original = context.Rsp;
+  const std::uintptr_t copy = reinterpret_cast<std::uintptr_t>(buffer.data());
+  const auto rebase = [&](DWORD64 &value) {
+    if (value >= original && value < original + copied)
+      value = value - original + copy;
+  };
+  for (std::size_t offset = 0; offset + 8 <= copied; offset += 8)
+    rebase(*reinterpret_cast<DWORD64 *>(buffer.data() + offset));
+  for (DWORD64 *reg : {&context.Rax, &context.Rbx, &context.Rcx, &context.Rdx, &context.Rsi,
+                       &context.Rdi, &context.Rbp, &context.Rsp, &context.R8, &context.R9,
+                       &context.R10, &context.R11, &context.R12, &context.R13, &context.R14,
+                       &context.R15})
+    rebase(*reg);
+
+  std::uintptr_t frames[kMaxNativeFrames];
+  const int count = UnwindFrames(&context, copy, copy + copied, frames, kMaxNativeFrames);
+  stack.frames.assign(frames, frames + count);
+  if (copied == buffer.size())
+    stack.note = "stack copy truncated";
+}
+
+void CaptureCurrentThread(const CONTEXT &crash_context, NativeStack &stack) {
+  stack.thread_id = GetCurrentThreadId();
+  stack.name = ThreadName(GetCurrentThread());
+  ULONG_PTR low = 0, high = 0;
+  GetCurrentThreadStackLimits(&low, &high);
+  CONTEXT context = crash_context;
+  std::uintptr_t frames[kMaxNativeFrames];
+  const int count = UnwindFrames(&context, low, high, frames, kMaxNativeFrames);
+  stack.frames.assign(frames, frames + count);
+}
+
+// The copy of another thread's stack, reused by every capture on the calling thread.
+std::vector<std::uint8_t> &StackCopyBuffer() {
+  thread_local std::vector<std::uint8_t> buffer(kMaxStackCopy);
+  return buffer;
+}
+
+struct ModuleInfo {
+  std::string name;
+  std::string path;
+  std::uintptr_t base = 0;
+};
+
+std::optional<ModuleInfo> ModuleAt(std::uintptr_t address) {
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCWSTR>(address), &module))
+    return std::nullopt;
+  wchar_t wide[MAX_PATH];
+  const DWORD length = GetModuleFileNameW(module, wide, MAX_PATH);
+  ModuleInfo info;
+  info.base = reinterpret_cast<std::uintptr_t>(module);
+  for (DWORD i = 0; i < length; ++i)
+    info.path += wide[i] < 0x80 ? static_cast<char>(wide[i]) : '?';
+  const std::size_t slash = info.path.find_last_of("\\/");
+  info.name = slash == std::string::npos ? info.path : info.path.substr(slash + 1);
+  return info;
+}
+#endif
+} // namespace
+
+bool CanCaptureNativeStacks() {
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  return true;
+#else
+  return false;
+#endif
+}
+
+NativeStack CaptureThreadStack(std::uint32_t thread_id) {
+  NativeStack stack;
+  stack.thread_id = thread_id;
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  if (thread_id == GetCurrentThreadId())
+    stack.note = "calling thread";
+  else
+    CaptureOtherThread(thread_id, StackCopyBuffer(), stack);
+#else
+  stack.note = "not supported on this platform";
+#endif
+  return stack;
+}
+
+std::vector<NativeStack> CaptureAllThreadStacks(const void *current_thread_context) {
+  std::vector<NativeStack> stacks;
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  std::vector<DWORD> thread_ids;
+  const DWORD process_id = GetCurrentProcessId();
+  HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+  if (snapshot != INVALID_HANDLE_VALUE) {
+    THREADENTRY32 entry{};
+    entry.dwSize = sizeof(entry);
+    for (BOOL ok = Thread32First(snapshot, &entry); ok; ok = Thread32Next(snapshot, &entry)) {
+      if (entry.th32OwnerProcessID == process_id)
+        thread_ids.push_back(entry.th32ThreadID);
+    }
+    CloseHandle(snapshot);
+  }
+
+  stacks.reserve(thread_ids.size());
+  const DWORD self = GetCurrentThreadId();
+  for (const DWORD thread_id : thread_ids) {
+    if (thread_id != self) {
+      stacks.push_back(CaptureThreadStack(thread_id));
+      continue;
+    }
+    NativeStack &stack = stacks.emplace_back();
+    stack.thread_id = thread_id;
+    if (current_thread_context)
+      CaptureCurrentThread(*static_cast<const CONTEXT *>(current_thread_context), stack);
+    else
+      stack.note = "diagnostics thread";
+  }
+#else
+  (void)current_thread_context;
+#endif
+  return stacks;
+}
+
+std::string DescribeAddress(std::uintptr_t address, std::map<std::string, std::string> &modules) {
+#ifdef MODERNGEKKO_NATIVE_STACKS
+  if (const std::optional<ModuleInfo> module = ModuleAt(address)) {
+    modules.emplace(module->name, module->path);
+    return fmt::format("{}+0x{:x}", module->name, address - module->base);
+  }
+#else
+  (void)modules;
+#endif
+  return fmt::format("0x{:016x} (no module: JIT code or bad frame)", address);
+}
+
+void DescribeModules(const std::map<std::string, std::string> &modules, std::string &out) {
+  out += "\n[modules]\n";
+  for (const auto &[name, path] : modules)
+    fmt::format_to(std::back_inserter(out), "  {} = {}\n", name, path);
+}
+} // namespace moderngekko
