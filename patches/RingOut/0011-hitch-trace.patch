diff --git a/ModernGekko/src/runtime/hitch_recorder.cpp b/ModernGekko/src/runtime/hitch_recorder.cpp
new file mode 100644
index 00000000..3870b0bc
--- /dev/null
+++ b/ModernGekko/src/runtime/hitch_recorder.cpp
@@ -0,0 +1,214 @@
+#include "hitch_recorder.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <fstream>
+#include <iterator>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "Common/Thread.h"
+#include "VideoCommon/VideoEvents.h"
+#include "thread_names.hpp"
+
+namespace moderngekko {
+namespace {
+namespace HitchTrace = Common::HitchTrace;
+using HitchTrace::Span;
+
+// About half a minute of waits at the rate a fight records them.
+constexpr std::size_t kTraceCapacity = 1 << 16;
+// Longer intervals are pauses, savestate loads or real freezes (the diagnostic reporter covers
+// those), not hitches.
+constexpr std::int64_t kMaxIntervalNs = 2'000'000'000;
+
+std::int64_t ToNs(std::chrono::milliseconds duration) {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(duration).count();
+}
+
+double ToMs(std::int64_t ns) { return static_cast<double>(ns) / 1e6; }
+
+std::string LocalTimestamp() {
+  const std::time_t now = std::time(nullptr);
+  std::tm local{};
+#ifdef _WIN32
+  localtime_s(&local, &now);
+#else
+  localtime_r(&now, &local);
+#endif
+  char text[32];
+  std::strftime(text, sizeof(text), "%Y%m%d-%H%M%S", &local);
+  return text;
+}
+
+// The interval spans carry the time the thread spent on a core, in microseconds.
+bool HasBusyTime(Span span) { return span == Span::ViField || span == Span::FramePresented; }
+} // namespace
+
+std::optional<HitchRecorder::Options>
+HitchRecorder::EnableFromEnvironment(std::filesystem::path directory) {
+  const char *value = std::getenv("RINGOUT_HITCH_TRACE");
+  const long threshold_ms = value ? std::strtol(value, nullptr, 10) : 0;
+  if (threshold_ms <= 0)
+    return std::nullopt;
+
+  HitchTrace::Enable(kTraceCapacity);
+  Options options;
+  options.directory = std::move(directory);
+  options.threshold = std::chrono::milliseconds(threshold_ms);
+  std::fprintf(stderr, "[hitch-trace] on: fields and frames over %ld ms are reported to %s\n",
+               threshold_ms, options.directory.string().c_str());
+  return options;
+}
+
+HitchRecorder::HitchRecorder(Options options)
+    : m_options(std::move(options)), m_session_start_ns(HitchTrace::NowNs()),
+      m_session_timestamp(LocalTimestamp()) {
+  VideoEvents &events = GetVideoEvents();
+  m_field_hook = events.vi_end_field_event.Register(
+      [this] { OnIntervalEnd(Span::ViField, m_field_clock); });
+  m_present_hook = events.after_present_event.Register(
+      [this](const PresentInfo &) { OnIntervalEnd(Span::FramePresented, m_present_clock); });
+  m_writer = std::jthread([this](std::stop_token stop) { WriterLoop(std::move(stop)); });
+}
+
+HitchRecorder::~HitchRecorder() {
+  // Unhook first, so no interval ends while the writer shuts down.
+  m_field_hook = {};
+  m_present_hook = {};
+}
+
+void HitchRecorder::OnIntervalEnd(Span span, IntervalClock &clock) {
+  const std::int64_t now_ns = HitchTrace::NowNs();
+  const std::int64_t busy_ns = HitchTrace::CurrentThreadBusyNs();
+  const std::int64_t start_ns = std::exchange(clock.last_ns, now_ns);
+  const std::int64_t busy_in_interval_ns = busy_ns - std::exchange(clock.last_busy_ns, busy_ns);
+  if (start_ns == 0)
+    return;
+
+  const std::int64_t busy_us = std::max<std::int64_t>(busy_in_interval_ns / 1000, 0);
+  HitchTrace::Record(span, start_ns, now_ns,
+                     static_cast<std::uint32_t>(std::min<std::int64_t>(busy_us, UINT32_MAX)));
+
+  const std::int64_t length_ns = now_ns - start_ns;
+  if (length_ns < ToNs(m_options.threshold) || length_ns > kMaxIntervalNs)
+    return;
+  {
+    std::lock_guard lock(m_mutex);
+    m_pending.push_back(Hitch{span, start_ns, now_ns, busy_in_interval_ns});
+  }
+  m_wake.notify_one();
+}
+
+void HitchRecorder::WriterLoop(std::stop_token stop) {
+  Common::SetCurrentThreadName("Hitch recorder");
+  const std::int64_t context_ns = ToNs(m_options.context);
+  std::int64_t reported_until_ns = 0;
+  std::unique_lock lock(m_mutex);
+  while (m_wake.wait(lock, stop, [this] { return !m_pending.empty(); })) {
+    const Hitch hitch = m_pending.front();
+    m_pending.pop_front();
+
+    // A span is recorded when it ends: give the ones still open at the end of the slow
+    // interval the context time to close.
+    const std::int64_t wait_ns = hitch.end_ns + context_ns - HitchTrace::NowNs();
+    if (wait_ns > 0)
+      m_wake.wait_for(lock, stop, std::chrono::nanoseconds(wait_ns), [] { return false; });
+    if (stop.stop_requested())
+      return;
+
+    // A slow field usually comes with a slow frame (and the other way round): one report.
+    if (hitch.start_ns < reported_until_ns || m_reports_written >= m_options.max_reports)
+      continue;
+    reported_until_ns = hitch.end_ns + context_ns;
+    ++m_reports_written;
+
+    lock.unlock();
+    WriteReport(hitch);
+    lock.lock();
+  }
+}
+
+void HitchRecorder::WriteReport(const Hitch &hitch) {
+  const std::int64_t context_ns = ToNs(m_options.context);
+  const std::vector<HitchTrace::Event> events =
+      HitchTrace::Collect(hitch.start_ns - context_ns, hitch.end_ns + context_ns);
+
+  std::string out = fmt::format(
+      "Hitch report {}\n\n"
+      "slow {}: {:.1f} ms (threshold {} ms), {:.1f} ms of it on a core, {:.3f} s into the "
+      "session\n",
+      m_reports_written, HitchTrace::GetName(hitch.span), ToMs(hitch.end_ns - hitch.start_ns),
+      m_options.threshold.count(), ToMs(hitch.busy_ns),
+      ToMs(hitch.start_ns - m_session_start_ns) / 1000.0);
+
+  // Time each thread spent in each kind of wait inside the slow interval.
+  struct Total {
+    std::int64_t ns = 0;
+    int spans = 0;
+  };
+  std::map<std::pair<std::uint32_t, Span>, Total> totals;
+  for (const HitchTrace::Event &event : events) {
+    if (HasBusyTime(event.span))
+      continue;
+    const std::int64_t overlap_ns =
+        std::min(event.end_ns, hitch.end_ns) - std::max(event.start_ns, hitch.start_ns);
+    if (overlap_ns <= 0)
+      continue;
+    Total &total = totals[{event.thread_id, event.span}];
+    total.ns += overlap_ns;
+    ++total.spans;
+  }
+  out += "\nwaits inside the slow interval (clipped to it):\n";
+  if (totals.empty())
+    out += "  none\n";
+  for (const auto &[key, total] : totals) {
+    fmt::format_to(std::back_inserter(out), "  {:<28} {:<16} {:8.1f} ms in {} span(s)\n",
+                   ThreadLabel(key.first), HitchTrace::GetName(key.second), ToMs(total.ns),
+                   total.spans);
+  }
+
+  fmt::format_to(std::back_inserter(out),
+                 "\nevents from -{} ms to +{:.0f} ms (times in ms from the start of the slow "
+                 "interval; spans shorter than 0.01 ms are not recorded):\n"
+                 "    start    length  {:<28} {:<16} on a core\n",
+                 m_options.context.count(), ToMs(hitch.end_ns - hitch.start_ns + context_ns),
+                 "thread", "span");
+  for (const HitchTrace::Event &event : events) {
+    fmt::format_to(std::back_inserter(out), "{:9.3f} {:9.3f}  {:<28} {:<16}",
+                   ToMs(event.start_ns - hitch.start_ns), ToMs(event.end_ns - event.start_ns),
+                   ThreadLabel(event.thread_id), HitchTrace::GetName(event.span));
+    if (HasBusyTime(event.span))
+      fmt::format_to(std::back_inserter(out), " {:.1f}", event.detail / 1000.0);
+    out += '\n';
+  }
+
+  std::error_code error;
+  std::filesystem::create_directories(m_options.directory, error);
+  const std::filesystem::path path =
+      m_options.directory /
+      fmt::format("hitch-{}-{:02}.txt", m_session_timestamp, m_reports_written);
+  std::ofstream file(path, std::ios::binary);
+  file << out;
+  if (file)
+    std::fprintf(stderr, "[hitch-trace] slow %s (%.1f ms): %s\n",
+                 HitchTrace::GetName(hitch.span), ToMs(hitch.end_ns - hitch.start_ns),
+                 path.string().c_str());
+}
+
+const std::string &HitchRecorder::ThreadLabel(std::uint32_t thread_id) {
+  auto it = m_thread_labels.find(thread_id);
+  if (it == m_thread_labels.end()) {
+    const std::string name = ThreadNameById(thread_id);
+    it = m_thread_labels
+             .emplace(thread_id, fmt::format("{} [{}]", name.empty() ? "thread" : name, thread_id))
+             .first;
+  }
+  return it->second;
+}
+} // namespace moderngekko
