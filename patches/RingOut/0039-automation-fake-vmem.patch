+// Host pointer for a guest range: main RAM (through MemoryManager), or the fake VMEM at
+// 0x7E000000 that games running without the MMU keep heap data in. Null when out of range.
+u8* AutomationGuestRange(Memory::MemoryManager& memory, u32 address, size_t size)
+{
+  constexpr u32 fake_vmem_base = 0x7E000000;
+  u8* fake_vmem = memory.GetFakeVMEM();
+  if (fake_vmem && address >= fake_vmem_base && address - fake_vmem_base < memory.GetFakeVMemSize())
+  {
+    const u32 offset = address - fake_vmem_base;
+    return size <= memory.GetFakeVMemSize() - offset ? fake_vmem + offset : nullptr;
+  }
+  return memory.GetPointerForRange(address, size);
+}
