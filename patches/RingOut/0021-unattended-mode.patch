+// Unattended mode: the automation directory plays the game and the player only
+// watches, so the menu and its hotkeys stay shut and a banner says what is going
+// on. The flag is read on the host thread, the text written by the automation
+// thread and drawn on the video thread.
+std::atomic<bool> s_unattended{false};
+std::mutex& s_banner_mutex = *new std::mutex;
+std::string& s_banner_text = *new std::string;
+
+// A dark box across the top of the screen: the first line of the text as the
+// heading, in the game-style heavy face, the rest below it.
+void DrawUnattendedBanner()
+{
+  if (!s_unattended.load(std::memory_order_relaxed))
+    return;
+  std::string text;
+  {
+    std::lock_guard<std::mutex> guard(s_banner_mutex);
+    text = s_banner_text;
+  }
+  if (text.empty())
+    return;
+  const std::size_t newline = text.find('\n');
+  const std::string heading = text.substr(0, newline);
+  const std::string body = newline == std::string::npos ? std::string() : text.substr(newline + 1);
+
+  const ImGuiViewport* vp = ImGui::GetMainViewport();
+  // Sized from the window height so it reads from the couch at any resolution.
+  const float ui = std::clamp(vp->Size.y / 720.0f, 1.0f, 3.0f);
+  const float width = std::min(vp->Size.x - 32.0f, 1000.0f * ui);
+  ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + vp->Size.x * 0.5f, vp->Pos.y + 24.0f * ui),
+                          ImGuiCond_Always, ImVec2(0.5f, 0.0f));
+  ImGui::SetNextWindowSize(ImVec2(width, 0.0f), ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.85f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(24.0f * ui, 16.0f * ui));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f * ui);
+  ImGui::Begin("UnattendedBanner", nullptr,
+               ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs |
+                   ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing |
+                   ImGuiWindowFlags_NoNav);
+  ImGui::PushFont(s_bold_font, 0.0f);
+  ImGui::SetWindowFontScale(2.4f * ui);
+  // Pulses so it reads as a live status rather than part of the game's HUD.
+  const float pulse = 0.75f + 0.25f * static_cast<float>(std::sin(ImGui::GetTime() * 3.0));
+  ImGui::TextColored(ImVec4(1.0f, 0.82f * pulse + 0.1f, 0.2f, 1.0f), "%s", heading.c_str());
+  ImGui::PopFont();
+  if (!body.empty())
+  {
+    ImGui::SetWindowFontScale(1.5f * ui);
+    ImGui::PushTextWrapPos(0.0f);
+    ImGui::TextUnformatted(body.c_str());
+    ImGui::PopTextWrapPos();
+  }
+  ImGui::SetWindowFontScale(1.0f);
+  ImGui::End();
+  ImGui::PopStyleVar(2);
