+bool StaticRecompCore::ResetModuleProfile()
+{
+  if (!m_library.IsOpen())
+    return false;
+  using ResetFn = void (*)();
+  const auto reset =
+      reinterpret_cast<ResetFn>(m_library.GetSymbolAddress("staticrecomp_profile_reset"));
+  if (!reset)
+    return false;
+  // The CPU thread may be counting meanwhile; a few counts more or less do not matter.
+  reset();
+  return true;
+}
