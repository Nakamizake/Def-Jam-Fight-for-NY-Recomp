+// Guest address of a periodic OSAlarm to run in step with the video fields (0 = off), how many
+// times it fires per field, and when the first of them fires, in microseconds after a field
+// ends. For games that pace their logic with a timer at a round rate (say 120 Hz) against
+// 59.94 Hz fields: the two drift past each other, and around the crossing the logic steps
+// twice in one frame and not at all in the next. Set per game, in its GameSettings ini.
+const Info<u32> MAIN_VI_LOCKED_ALARM{{System::Main, "Core", "ViLockedAlarm"}, 0};
+const Info<u32> MAIN_VI_LOCKED_ALARM_PER_FIELD{{System::Main, "Core", "ViLockedAlarmPerField"}, 1};
+const Info<u32> MAIN_VI_LOCKED_ALARM_PHASE_US{{System::Main, "Core", "ViLockedAlarmPhaseUs"}, 0};
+// Optional float the game counts the alarm with, reset every field so it acts on the same
+// firing each time: the address of a pointer to it (0 = none), its offset there, and the value.
+const Info<u32> MAIN_VI_LOCKED_ALARM_DIVIDER_POINTER{
+    {System::Main, "Core", "ViLockedAlarmDividerPointer"}, 0};
+const Info<u32> MAIN_VI_LOCKED_ALARM_DIVIDER_OFFSET{
+    {System::Main, "Core", "ViLockedAlarmDividerOffset"}, 0};
+const Info<float> MAIN_VI_LOCKED_ALARM_DIVIDER_VALUE{
+    {System::Main, "Core", "ViLockedAlarmDividerValue"}, 0.0f};
 #if defined(ANDROID)
 // Currently enabled by default on Android because the performance boost is really needed.
 constexpr bool DEFAULT_CPU_THREAD = true;
