+// The code as hex text, and while it is being edited the live digit marked with
+// >< the way FormatAddress marks an octet.
+std::string FormatHostCode(const std::array<int, 8>& code, int editing_digit)
+{
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string out;
+  for (int i = 0; i < static_cast<int>(code.size()); ++i)
+  {
+    if (i == editing_digit)
+      out += '>';
+    out += kHex[code[i] & 0xf];
+    if (i == editing_digit)
+      out += '<';
+  }
+  return out;
+}
+
+// True when the text is a host code (spaces around it and upper case allowed, as
+// people paste it), in which case its digits are filled in.
+bool ParseHostCode(std::string_view text, std::array<int, 8>* code)
+{
+  const auto first = text.find_first_not_of(" \t\r\n");
+  if (first == std::string_view::npos)
+    return false;
+  text = text.substr(first, text.find_last_not_of(" \t\r\n") - first + 1);
+  if (text.size() != code->size())
+    return false;
+  std::array<int, 8> digits{};
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    const unsigned char c = static_cast<unsigned char>(text[i]);
+    if (!std::isxdigit(c))
+      return false;
+    digits[i] = std::isdigit(c) ? c - '0' : std::tolower(c) - 'a' + 10;
+  }
+  *code = digits;
+  return true;
+}
