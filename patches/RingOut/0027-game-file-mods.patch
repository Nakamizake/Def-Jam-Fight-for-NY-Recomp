+// Game-file mods (Load/Mods/<name>/files/) go onto the disc through Dolphin's
+// Riivolution file patching: each mod is a folder patch from its files/ tree
+// onto the disc root, replacing files by path and adding new ones, with the
+// sizes the FST is rebuilt around. The extracted game is never written to.
+// Riivolution applies patches in order and a later one overwrites an earlier
+// one, so they go in lowest precedence first and the first-named mod wins.
+void ApplyGameFileMods(BootParameters *boot) {
+  const std::vector<RecompMods::GameFilesMod> mods = RecompMods::EnabledGameFiles();
+  std::vector<std::string> applied;
+  std::vector<DiscIO::Riivolution::Patch> patches;
+  for (auto it = mods.rbegin(); it != mods.rend(); ++it) {
+    DiscIO::Riivolution::Patch patch;
+    patch.m_id = it->name;
+    // Relative external paths resolve against the folder of the "XML file",
+    // which is the files/ folder itself; no XML exists or is read.
+    patch.m_file_data_loader = std::make_shared<DiscIO::Riivolution::FileDataLoaderHostFS>(
+        it->files_root, it->files_root + "/mod.xml", std::string_view{});
+    DiscIO::Riivolution::Folder folder;
+    folder.m_disc = "/";
+    folder.m_external = "";
+    folder.m_create = true;
+    folder.m_recursive = true;
+    patch.m_folder_patches.push_back(std::move(folder));
+    patches.push_back(std::move(patch));
+    applied.push_back(it->name);
+    std::fprintf(stderr, "[mods] game files from '%s'\n", it->name.c_str());
+  }
+  RecompMods::SetAppliedGameFiles(applied);
+  AddRiivolutionPatches(boot, std::move(patches));
+}
