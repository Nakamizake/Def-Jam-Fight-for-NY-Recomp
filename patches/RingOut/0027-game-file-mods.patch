+bool IsNamedFiles(const std::filesystem::path& path)
+{
+  std::string name = path.filename().string();
+  for (char& c : name)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  return name == "files";
+}
+
+// The mod's game-file tree: a `files` folder at its top, or one level down for
+// an archive that wraps everything in a folder of its own. Empty when none.
+std::filesystem::path FindFilesRoot(const std::filesystem::path& folder)
+{
+  std::error_code ec;
+  std::vector<std::filesystem::path> subfolders;
+  for (const auto& entry : std::filesystem::directory_iterator(folder, ec))
+  {
+    if (!entry.is_directory(ec))
+      continue;
+    if (IsNamedFiles(entry.path()))
+      return entry.path();
+    subfolders.push_back(entry.path());
+  }
+  if (subfolders.size() == 1)
+  {
+    for (const auto& entry : std::filesystem::directory_iterator(subfolders.front(), ec))
+    {
+      if (entry.is_directory(ec) && IsNamedFiles(entry.path()))
+        return entry.path();
+    }
+  }
+  return {};
+}
