+
+std::string GameFilesFingerprint()
+{
+  // The disc path each file lands on, lower-cased as the FST lookup is
+  // case-insensitive; the first mod to supply a path wins, as at boot.
+  std::map<std::string, std::filesystem::path> winners;
+  for (const auto& mod : EnabledGameFiles())
+  {
+    std::error_code ec;
+    const std::filesystem::path root(mod.files_root);
+    for (const auto& entry : std::filesystem::recursive_directory_iterator(root, ec))
+    {
+      if (!entry.is_regular_file(ec))
+        continue;
+      std::string disc_path = entry.path().lexically_relative(root).generic_string();
+      for (char& c : disc_path)
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+      winners.try_emplace(std::move(disc_path), entry.path());
+    }
+  }
+  if (winners.empty())
+    return "none";
+
+  auto context = Common::SHA1::CreateContext();
+  std::vector<u8> buffer(1 << 20);
+  for (const auto& [disc_path, host_path] : winners)
+  {
+    context->Update(reinterpret_cast<const u8*>(disc_path.data()), disc_path.size() + 1);
+    std::ifstream file(host_path, std::ios::binary);
+    while (file)
+    {
+      file.read(reinterpret_cast<char*>(buffer.data()), static_cast<std::streamsize>(buffer.size()));
+      context->Update(buffer.data(), static_cast<size_t>(file.gcount()));
+    }
+  }
+  return Common::SHA1::DigestToString(context->Finish());
+}
