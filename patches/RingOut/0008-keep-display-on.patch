+
+// Gamepad input does not reset the OS idle timer, so without this the display could go to sleep
+// in the middle of a fight played on a controller. Held for the whole session, as Dolphin does
+// while a game runs.
+class ScreenSaverInhibitor {
+public:
+  explicit ScreenSaverInhibitor(bool active) : m_active(active) {
+    if (m_active)
+      UICommon::InhibitScreenSaver(true);
+  }
+  ~ScreenSaverInhibitor() {
+    if (m_active)
+      UICommon::InhibitScreenSaver(false);
+  }
+  ScreenSaverInhibitor(const ScreenSaverInhibitor &) = delete;
+  ScreenSaverInhibitor &operator=(const ScreenSaverInhibitor &) = delete;
+
+private:
+  bool m_active;
+};
 } // namespace
 
