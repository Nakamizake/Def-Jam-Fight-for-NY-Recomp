+std::vector<NativeStack> HitchRecorder::CaptureStacks(std::uint32_t interval_thread_id) {
+  std::vector<NativeStack> stacks = CaptureAllThreadStacks(nullptr);
+  // The calling thread (this sampler) has nothing to show.
+  const auto self = static_cast<std::uint32_t>(Common::CurrentThreadId());
+  std::erase_if(stacks, [self](const NativeStack &stack) { return stack.thread_id == self; });
+  const auto interval_thread =
+      std::find_if(stacks.begin(), stacks.end(), [interval_thread_id](const NativeStack &stack) {
+        return stack.thread_id == interval_thread_id;
+      });
+  if (interval_thread != stacks.end())
+    std::rotate(stacks.begin(), interval_thread, interval_thread + 1);
+  return stacks;
+}
