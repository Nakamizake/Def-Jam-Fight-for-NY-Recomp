+  if (m_gamepad != nullptr)
+  {
+    for (int i = 0; i != SDL_GAMEPAD_BUTTON_COUNT; ++i)
+      state.buttons[i] = SDL_GetGamepadButton(m_gamepad, SDL_GamepadButton(i));
+    for (int i = 0; i != SDL_GAMEPAD_AXIS_COUNT; ++i)
+      state.axes[i] = SDL_GetGamepadAxis(m_gamepad, SDL_GamepadAxis(i));
+    for (std::size_t i = 0; i != m_sensor_types.size(); ++i)
+    {
+      state.sensors[i] = {};
