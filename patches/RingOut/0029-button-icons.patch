+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// RingOut: button icons that follow the player's controls.
+//
+// A GameCube game draws GameCube buttons: a green A, a red B. Played on a PlayStation pad, an
+// Xbox pad or the keyboard, and with remappable controls, those icons point at buttons the
+// player does not have. This replaces each icon texture the game lists in
+// Load/ButtonIcons/targets.ini with one drawn for what actually performs that action: the pad
+// control's binding on port 1, in the style of the device in use (glyphs/<style>/<input>.png),
+// switching to the keyboard's keys when a bound key is pressed and back on pad input.
+//
+// The icons are composed into the cache directory and served by the texture loader as custom
+// textures, so they are host-side only: nothing reaches guest RAM, netplay is unaffected.
+
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace RecompButtonIcons
+{
+// The player's CHOICE (Dolphin.ini [RecompMenu] ButtonIcons): kAuto follows the device in use,
+// a style name (GameCube, PlayStation, Xbox, Switch, Keyboard) always draws that one, kOff
+// leaves the game's own icons.
+inline constexpr std::string_view kAuto = "Auto";
+inline constexpr std::string_view kOff = "Off";
+
+// Every choice, in menu order.
+std::vector<std::string> Choices();
+std::string GetChoice();
+// Records the choice in the base config layer (the caller saves the config). A style change
+// shows at once; turning the icons on or off takes effect the next time the game starts, as the
+// texture loader only lists its directories then.
+void SetChoice(const std::string& choice);
+// The choice as the menu shows it, marked when it waits for the next start.
+std::string Describe();
+
+// Reads the targets and composes every icon for the device port 1 is on, then watches for the
+// player switching devices. Call once the pads are configured and before the game boots: the
+// texture loader picks the composed icons up when the video backend starts.
+void Initialize();
+void Shutdown();
+
+// The directory the composed icons are written to; empty while the choice is Off or the game
+// lists no targets.
+std::string TextureDirectory();
+}  // namespace RecompButtonIcons
