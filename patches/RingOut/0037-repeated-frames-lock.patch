diff --git a/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.cpp b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.cpp
new file mode 100644
index 00000000..1589f9bc
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.cpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoCommon/RepeatedFrames.h"
+
+#include <atomic>
+#include <cstring>
+
+namespace RepeatedFrames
+{
+namespace
+{
+std::atomic<bool> s_enabled{false};
+
+// GPU thread only.
+u64 s_hash = 0;
+u64 s_previous_hash = 0;
+bool s_previous_repeated = true;
+
+std::atomic<u64> s_copies{0};
+std::atomic<u64> s_repeats{0};
+std::atomic<u64> s_alternating_repeats{0};
+
+constexpr u64 HASH_START = 0xCBF29CE484222325ull;
+constexpr u64 HASH_PRIME = 0x100000001B3ull;
+}  // namespace
+
+void SetEnabled(bool enabled)
+{
+  s_enabled.store(enabled, std::memory_order_relaxed);
+}
+
+bool IsEnabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+
+void OnXFLoad(const void* data, std::size_t size)
+{
+  if (!IsEnabled())
+    return;
+
+  const auto* bytes = static_cast<const u8*>(data);
+  u64 hash = s_hash == 0 ? HASH_START : s_hash;
+  std::size_t i = 0;
+  for (; i + sizeof(u64) <= size; i += sizeof(u64))
+  {
+    u64 word;
+    std::memcpy(&word, bytes + i, sizeof(word));
+    hash = (hash ^ word) * HASH_PRIME;
+    hash ^= hash >> 29;
+  }
+  for (; i < size; ++i)
+    hash = (hash ^ bytes[i]) * HASH_PRIME;
+  s_hash = hash;
+}
+
+void OnXFBCopy()
+{
+  if (!IsEnabled())
+    return;
+
+  const bool repeated = s_hash == s_previous_hash;
+  s_copies.fetch_add(1, std::memory_order_relaxed);
+  if (repeated)
+  {
+    s_repeats.fetch_add(1, std::memory_order_relaxed);
+    if (!s_previous_repeated)
+      s_alternating_repeats.fetch_add(1, std::memory_order_relaxed);
+  }
+  s_previous_repeated = repeated;
+  s_previous_hash = s_hash;
+  s_hash = 0;
+}
+
+Counts Get()
+{
+  return {s_copies.load(std::memory_order_relaxed), s_repeats.load(std::memory_order_relaxed),
+          s_alternating_repeats.load(std::memory_order_relaxed)};
+}
+}  // namespace RepeatedFrames
diff --git a/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.h b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.h
new file mode 100644
index 00000000..7aae8b86
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RepeatedFrames.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+
+#include "Common/CommonTypes.h"
+
+// Counts XFB copies whose GPU input repeats the previous copy's, for frame pacing checks made
+// outside the video backend.
+//
+// A game can draw the same scene twice in a row and show half its frame rate while every field
+// still gets a fresh XFB copy, so counting copies or presents does not see it. What the copies
+// were drawn from does: the XF register loads in the command stream (matrices, viewport,
+// lights) change whenever anything on screen moves, and hashing them is cheap. A copy whose XF
+// loads hash the same as the previous copy's counts as a repeat.
+//
+// Off (and free) until something enables it. The hooks run on the GPU thread; Get() may be
+// called from any thread.
+namespace RepeatedFrames
+{
+struct Counts
+{
+  u64 copies = 0;
+  // Copies that repeated the previous copy.
+  u64 repeats = 0;
+  // Repeats that came right after a copy that did not repeat: the drawn, repeated, drawn,
+  // repeated... pattern of a scene shown at half rate. A still scene repeats every copy and adds
+  // nothing here.
+  u64 alternating_repeats = 0;
+};
+
+void SetEnabled(bool enabled);
+bool IsEnabled();
+
+// XF register data loaded from the command stream.
+void OnXFLoad(const void* data, std::size_t size);
+// An EFB copy to the XFB: closes the frame drawn since the previous one.
+void OnXFBCopy();
+
+Counts Get();
+}  // namespace RepeatedFrames
